{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "handlers": ["stderr"],
    "level": "INFO"
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["stderr"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stderr"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    },
    "app.access": {
      "handlers": [],
      "level": "CRITICAL",
      "propagate": false
    }
  }
}
