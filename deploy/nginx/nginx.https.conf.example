# 高校学生全生命周期管理平台 · HTTPS Nginx 配置模板
# 用法：把 <your-domain> 换成你的域名；证书路径换成你 certbot/云厂商签发的实际路径。
# 证书获取（任选其一）：
#   1) Let's Encrypt 免费证书：  sudo certbot --nginx -d <your-domain>
#   2) 云厂商（腾讯云/阿里云）免费 SSL 证书：控制台申请后下载 nginx 版，上传到 /etc/nginx/ssl/
# 配好后：nginx -t 测试 → systemctl reload nginx

# HTTP 全量跳转 HTTPS
server {
    listen 80;
    server_name <your-domain>;
    # certbot 验证目录（用 webroot 方式时保留）
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name <your-domain>;

    ssl_certificate     /etc/nginx/ssl/<your-domain>.pem;      # 证书（fullchain）
    ssl_certificate_key /etc/nginx/ssl/<your-domain>.key;      # 私钥
    ssl_session_timeout 10m;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;                              # 禁用不安全的旧协议
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # 安全响应头
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 60m;                                  # 与后端上传上限一致
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml;

    # PC 管理端（前端 dist）
    root /var/www/school-lifecycle/pc;
    index index.html;
    location / {
        try_files $uri $uri/ /index.html;                      # history 路由兜底
        add_header Cache-Control "no-cache";
    }
    location /assets/ { expires 30d; add_header Cache-Control "public,max-age=2592000"; }

    # miniapp H5
    location /miniapp/ {
        alias /var/www/school-lifecycle/miniapp/;
        try_files $uri $uri/ /miniapp/index.html;
    }

    # 后端 API 反代（同源，前端 VITE_API_BASE_URL 留空即走 /api/v1）
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    location = /health { proxy_pass http://127.0.0.1:8000/health; }

    # 生产环境后端已自动关闭 /docs /openapi.json（APP_ENV=production）；此处再兜底拦一层
    location ~ ^/(docs|redoc|openapi.json) { return 404; }
}
