# =============================================================================
# 学生 PC 门户（student-portal）· 部署到 /portal/ 子路径的 Nginx 片段
# -----------------------------------------------------------------------------
# 用法：把下面的 location 块加入主站 server{}（与 PC 端 / 、miniapp /miniapp/、
#      后端 /api/ 反代并存）。student-portal 需以 base=/portal/ 构建（见 DEPLOY）。
# 关键：history 路由刷新子页不 404 —— try_files 兜底到 /portal/index.html。
# 不 hardcode 服务器 IP / localhost；后端地址走前端 VITE_API_BASE_URL + 本处 /api/ 反代。
# =============================================================================

# 学生 PC 门户静态站点（student-portal/dist 的内容放到此目录）
location /portal/ {
    alias /usr/share/nginx/html/student-portal/;
    index index.html;
    try_files $uri $uri/ /portal/index.html;   # 刷新 /portal/home 等子路由不 404
}

# 门户静态资源长缓存（文件名带哈希）
location ~* ^/portal/assets/.*\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|eot)$ {
    alias /usr/share/nginx/html/student-portal/assets/;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    access_log off;
}

# 说明：后端接口仍复用主站已有的 /api/ 反代（见 deploy/nginx/nginx.mysql.conf 的 location /api/）。
#      门户请求形如 /api/v1/mobile/me/portal-config，同源经 Nginx 转发到 backend:8000。
#      生产环境 mock-login 仍为 403（后端 assert_prod_flags_safe 强制），门户也从不调用它。
