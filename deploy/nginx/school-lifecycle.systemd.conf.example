# 2U4G 非容器部署站点。替换域名和证书路径后放到 /etc/nginx/conf.d/。
# 本文件位于 nginx http{} 内；生产安全头、请求体上限和限流统一由 security-*.conf 提供，
# 避免 systemd / Docker / 手工部署形成多套安全事实源。

upstream school_lifecycle_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name <YOUR_DOMAIN>;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name <YOUR_DOMAIN>;
    ssl_certificate /etc/letsencrypt/live/<YOUR_DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<YOUR_DOMAIN>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;

    # 安全响应头 / 请求体上限 / 限流 / 静态目录封禁：统一走 PR #62 收敛后的安全合同。
    # 前提：http{} 里已 include security-http.conf。
    include /etc/nginx/conf.d/security-server.conf;

    # HSTS 只应出现在 HTTPS server；其余响应头由 security-server.conf 统一提供。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://school_lifecycle_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location = /health { proxy_pass http://school_lifecycle_backend/health; }
    location = /health/ready { proxy_pass http://school_lifecycle_backend/health/ready; }
    location ~ ^/(docs|redoc|openapi.json) { return 404; }

    # 小程序 H5。
    location ^~ /miniapp/ {
        root /var/www/school-lifecycle;
        try_files $uri $uri/ /miniapp/index.html;
    }

    # 学生 PC 门户与本次 release 原子切换到 /var/www/school-lifecycle/portal。
    location ^~ /portal/assets/ {
        root /var/www/school-lifecycle;
        try_files $uri =404;
        expires 1y;
        access_log off;
    }
    location ^~ /portal/ {
        root /var/www/school-lifecycle;
        try_files $uri $uri/ /portal/index.html;
    }
    location = /portal/index.html {
        root /var/www/school-lifecycle;
        expires -1;
    }

    # PC 管理端。
    location / {
        root /var/www/school-lifecycle/pc;
        try_files $uri $uri/ /index.html;
    }
    location = /index.html {
        root /var/www/school-lifecycle/pc;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|eot)$ {
        root /var/www/school-lifecycle/pc;
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
