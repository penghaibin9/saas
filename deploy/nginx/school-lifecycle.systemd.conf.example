# 2U4G 非容器部署站点。替换域名和证书路径后放到 /etc/nginx/conf.d/。
upstream school_lifecycle_backend {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name <YOUR_DOMAIN>;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name <YOUR_DOMAIN>;
    ssl_certificate /etc/letsencrypt/live/<YOUR_DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<YOUR_DOMAIN>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    # 安全响应头 / 请求体上限 / 限流 / 静态目录封禁：统一走安全合同片段。
    # 前提：http{} 里已 include security-http.conf。
    include /etc/nginx/conf.d/security-server.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://school_lifecycle_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location = /health { proxy_pass http://school_lifecycle_backend/health; }
    location = /health/ready { proxy_pass http://school_lifecycle_backend/health/ready; }
    location ~ ^/(docs|redoc|openapi.json) { return 404; }
    location ~ ^/(uploads|exports)/ { return 404; }

    location ^~ /miniapp/ {
        root /var/www/school-lifecycle;
        try_files $uri $uri/ /miniapp/index.html;
    }
    location / {
        root /var/www/school-lifecycle/pc;
        try_files $uri $uri/ /index.html;
    }
    location = /index.html {
        root /var/www/school-lifecycle/pc;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?|ttf|eot)$ {
        root /var/www/school-lifecycle/pc;
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
