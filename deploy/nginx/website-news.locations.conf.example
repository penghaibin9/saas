# 已退役的学校站点旧新闻片段。独立官网配置位于 website/deploy/。
        # 官网及新闻独立运行；旧地址不得落回学校应用或学校接口。
        location = /news { return 404; }
        location ^~ /news/ { return 404; }
        location = /api/v1/platform/website-news { return 404; }
        location ^~ /api/v1/platform/website-news/ { return 404; }
        location = /api/v1/website-news { return 404; }
        location ^~ /api/v1/website-news/ { return 404; }
        location = /api/v1/notification/website-lead { return 404; }
        location = /api/v1/notification/website-wechat-signature { return 404; }
        location ^~ /official-site/ { return 404; }
