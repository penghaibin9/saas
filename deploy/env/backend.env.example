# =============================================================================
# 后端服务 · 环境变量示例（P5 部署准备 · 本地 docker-compose 预演用）
# 用法：cp backend.env.example backend.env（同目录下，去掉 .example），按需修改。
#      docker-compose.local.yml 通过 env_file 读取本文件（../env/backend.env）。
# 技术栈：Python FastAPI + SQLAlchemy 2.x + Alembic + Uvicorn + psycopg（PostgreSQL）。
#
# ★ 现状说明（如实记录，见 AI执行状态.md / backend/README.md）：
#   backend 现在【已是可运行的 FastAPI 工程】（非早期"预留壳"阶段），本地非 Docker 运行时
#   默认走 backend/.env 的 SQLite（DB_ENABLED=true + sqlite dev.db）。
#   本文件是【docker-compose 本地预演】专用：把 DATABASE_URL 指向 compose 里的
#   postgres 容器（真实 PostgreSQL），但 Postgres 库首次使用是【空库】，
#   需先手动执行一次迁移建表，接口才能真正读写成功：
#     docker compose -f deploy/docker/docker-compose.local.yml exec backend alembic upgrade head
#   不执行迁移也不会报错崩溃 —— 只是 DB_ENABLED=true 时具体的数据库读写接口会报错，
#   如暂不迁移，可把下面 DB_ENABLED 改回 false，接口自动退回 mock 数据。
#   真实密钥/密码请自行修改，且【不要提交 git】（本文件已在 .gitignore 允许，backend.env 会被忽略）。
# =============================================================================

# 运行环境：dev / test / prod
APP_ENV=dev

# 后端服务监听端口（与 Dockerfile EXPOSE、docker-compose 8000:8000、Nginx proxy_pass 保持一致）
APP_PORT=8000

# ── 数据库：PostgreSQL（docker-compose 里的 postgres 服务；用户名/密码需与该服务一致）──
# 注意：docker-compose.local.yml 的 backend.environment 已用同样规则覆盖了 DATABASE_URL
#      （服务名 postgres 而非 localhost），这里的值主要供「不用 docker-compose、
#      直接读取本文件」的场景参考，请保持两处一致。
DB_ENABLED=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/student_lifecycle

# ── 缓存：Redis（预留）── backend 当前代码只读取该变量占位，尚未接入真实缓存逻辑
REDIS_URL=redis://redis:6379/0

# ── JWT（务必在真实环境改成强随机值，不要沿用示例）──
JWT_SECRET=change-me-in-local-rehearsal
JWT_SECRET_KEY=change-me-in-local-rehearsal
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS：允许通过 Nginx 访问的前端来源（本地预演端口，见 docker-compose 80/8080）──
CORS_ORIGINS=http://localhost,http://localhost:8080

# ── 文件与审计 ──
UPLOAD_DIR=./uploads
AUDIT_ENABLED=true

# ── 多租户 ──
TENANCY_MODE=single
DEFAULT_TENANT_CODE=demo

# ── 文件/对象存储（预留，当前未接入 MinIO/OSS）──
FILE_STORAGE_TYPE=
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# 说明：本文件只用于「本地 docker-compose 部署预演」。
#      非 Docker 本机开发请继续用 backend/.env.example（SQLite，默认已够用）。
