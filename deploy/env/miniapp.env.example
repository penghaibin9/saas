# =============================================================================
# 小程序端 · 环境变量 / 配置示例（P5 部署准备 · docker-compose 本地预演更新）
# 说明见 docs/07-部署运维交付与商业化/deploy/08-环境变量说明.md、docs/00-项目入口与总控/project-map/03-miniapp目录说明.md
#
# ★ 小程序当前的关键开关在源码 miniapp/src/config/env.js： useMock（本轮部署准备
#   不改 miniapp 源码，具体当前默认值以源码为准）。是否切换由开发同学在代码里处理，
#   本文件只提供「本地 docker-compose 预演」时可以参考填写的值。
# =============================================================================

# 是否使用 mock 假数据。对应源码 miniapp/src/config/env.js 的 ENV.useMock —— 本轮不改源码
MINIAPP_USE_MOCK=true

# 后端接口基础地址（连本地 docker-compose 预演时可参考填写；留空则维持 mock）：
#   - 经本地 docker-compose 的 Nginx（miniapp H5 站点，端口 8080）访问 → http://localhost:8080/api/v1
#   - 直接绕过 Nginx 访问 backend 容器端口（仅本地调试）→ http://localhost:8000/api/v1
MINIAPP_API_BASE_URL=

# 微信小程序 AppID（发布微信小程序时在 manifest.json / 微信后台配置；测试可用测试号）
# WEIXIN_APPID=

# 说明：小程序发布后若要联网后端，需在微信小程序后台配置服务器"合法域名"（正式上线阶段）。
#      本地 docker-compose 预演仅用于 H5 版本联调，微信小程序端（mp-weixin）不经 Nginx。
