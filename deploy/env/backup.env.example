# Copy to /etc/school-lifecycle/backup.env and chmod 600.
# This file is read only by school-lifecycle-backup.service.

# Local verified backup retention. The service sets BACKUP_DIR=/var/lib/school-lifecycle-backup.
KEEP_DAYS=14

# Production go-live recommendation: true. When true, a local backup is not considered successful
# unless the verified archive is also copied to BACKUP_RCLONE_REMOTE.
BACKUP_REQUIRE_OFFSITE=true

# Configure an rclone remote outside the repository. Tencent COS can be exposed through an
# S3-compatible/rclone remote; credentials must stay in rclone's protected config, not Git.
# Example only: yueke-cos:school-lifecycle/production-backups
BACKUP_RCLONE_REMOTE=

# Optional HTTPS webhook for backup failures. Leave empty only if systemd/journal is connected
# to another operational alert channel.
BACKUP_ALERT_WEBHOOK_URL=
