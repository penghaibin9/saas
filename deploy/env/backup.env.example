# Copy to /etc/school-lifecycle/backup.env and chmod 640.
# Recommended owner/group: root:schoolapp. This file is read only by school-lifecycle-backup.service.

# Local verified backup retention. The service pins BACKUP_DIR=/var/lib/school-lifecycle-backup.
KEEP_DAYS=14

# Uploads are part of the formal business record. Production must fail closed instead of silently
# succeeding with a database-only backup when the shared upload directory is absent.
UPLOAD_DIR=/opt/school-lifecycle/shared/uploads
REQUIRE_UPLOAD_BACKUP=1

# Production is always offsite-required. A local backup is not successful until every database,
# upload archive and SHA-256 sidecar has been copied and independently read back with the same hash.
BACKUP_REQUIRE_OFFSITE=true

# Keep the rclone config outside $HOME because the systemd service uses ProtectHome=true.
# Create this file outside Git, e.g. root:schoolapp mode 0640. Never put credentials in backup.env.
RCLONE_CONFIG=/etc/school-lifecycle/rclone.conf

# Configure a named rclone remote outside the repository. Tencent COS can be exposed through an
# S3-compatible/rclone remote. Example only: yueke-cos:school-lifecycle/production-backups
BACKUP_RCLONE_REMOTE=

# Anti-ransomware / accidental-deletion gate. Before changing CONFIRMED to true, enable and verify
# provider-side bucket versioning plus an immutable retention/Object-Lock policy (where supported),
# and a lifecycle policy that keeps historical versions for the school's required retention period.
# This flag is an operational go-live attestation; the generic rclone client cannot create/prove
# every cloud provider's immutable-storage policy itself.
BACKUP_REQUIRE_IMMUTABLE_REMOTE=true
BACKUP_IMMUTABLE_REMOTE_CONFIRMED=false

# Formal drill thresholds. MAX_BACKUP_AGE_SECONDS is the RPO freshness gate; MAX_RESTORE_SECONDS
# is the RTO restore-time gate used by deploy/backup/restore-drill.sh.
MAX_BACKUP_AGE_SECONDS=86400
MAX_RESTORE_SECONDS=900

# Optional HTTPS webhook for backup failures. Leave empty only if systemd/journal is connected
# to another operational alert channel.
BACKUP_ALERT_WEBHOOK_URL=
