# Copy to /etc/school-lifecycle/backup.env and chmod 640.
# Recommended owner/group: root:schoolapp. Never commit production credentials.

KEEP_DAYS=14
# With the default 6-hour cadence this keeps at least 48 hours of complete local recovery points.
MIN_LOCAL_BACKUP_SETS=8

UPLOAD_DIR=/opt/school-lifecycle/shared/uploads
REQUIRE_UPLOAD_BACKUP=1

# Production must fail closed: local-only success is not a successful backup.
BACKUP_REQUIRE_OFFSITE=true

# Keep rclone credentials outside $HOME because the systemd unit uses ProtectHome=true.
RCLONE_CONFIG=/etc/school-lifecycle/rclone.conf
# Example shape only: yueke-cos:school-lifecycle/production-backups
BACKUP_RCLONE_REMOTE=

# Anti-ransomware / accidental-deletion gate. Set CONFIRMED=true only after the cloud provider
# control plane has versioning plus immutable/WORM retention enabled and verified for this bucket.
BACKUP_REQUIRE_IMMUTABLE_REMOTE=true
BACKUP_IMMUTABLE_REMOTE_CONFIRMED=false

# Production recovery objectives. School contracts may choose stricter values, never looser ones.
MAX_BACKUP_AGE_SECONDS=21600
MAX_RESTORE_SECONDS=7200

# Optional HTTPS webhook for backup failures. Prefer a monitored ops endpoint.
BACKUP_ALERT_WEBHOOK_URL=
