POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=school_platform
POSTGRES_USER=
POSTGRES_PASSWORD=

# 说明：
# 1) 主键用应用层发号器（非自增）；不建物理外键；具体规范见冻结总册第 1 章。
# 2) 迁移用 Alembic 生成，不要手工建表、不要在冻结文档外另设计表结构。
# 3) 生产库端口不要对公网开放，仅对后端内网放通（见 docs/ops/07-安全加固清单.md）。
