# 跃科官网微信公众号微官网 JS-SDK。
# 公众号与微信小程序不是同一个 AppID/Secret；禁止复用 WX_APPID/WX_SECRET。
# 未完成公众号接入前保持 false，PC 官网与普通手机 H5 完全不受影响。
WECHAT_OFFICIAL_JS_SDK_ENABLED=false
WECHAT_OFFICIAL_APP_ID=
WECHAT_OFFICIAL_APP_SECRET=
WECHAT_OFFICIAL_ALLOWED_HOSTS=hnyueke.com,www.hnyueke.com
WECHAT_OFFICIAL_HTTP_TIMEOUT_SECONDS=5

# 公众号后台还需要把 hnyueke.com 配成“JS接口安全域名”。
# 若前端 https://hnyueke.com 调用 https://api.hnyueke.com，
# 后端 CORS_ORIGINS 必须包含 https://hnyueke.com。
