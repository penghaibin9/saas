# 官网 /contact 商务咨询短信（不写业务数据库）
# 复用现有短信密钥/签名/SDK AppID：SMS_ACCESS_KEY_ID、SMS_ACCESS_KEY_SECRET、SMS_SIGN_NAME、SMS_TENCENT_SDK_APP_ID。
SMS_ENABLED=true
SMS_PROVIDER=tencent

# 腾讯云需先审核专用模板。变量顺序固定：
# {1}=学校 {2}=联系人 {3}=访客电话 {4}=意向产品 {5}=留言摘要
# 示例文案：官网新咨询：学校{1}，联系人{2}，电话{3}，意向{4}，留言{5}。
SMS_TEMPLATE_WEBSITE_LEAD=

# 短信接收人；当前官网公开联系电话即商务接收号码。
WEBSITE_LEAD_NOTIFY_PHONE=13549666867

# 防滥用：每个来源 IP 每小时最多 6 次。生产使用 Redis 计数，键只含不可逆 IP 摘要。
WEBSITE_LEAD_RATE_LIMIT_PER_HOUR=6
# 建议生产配置独立随机盐；留空时代码使用 JWT_SECRET 参与摘要。
WEBSITE_LEAD_RATE_SALT=
