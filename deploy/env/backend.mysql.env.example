# =============================================================================
# 后端服务 · MySQL 版环境变量示例（用法：cp backend.mysql.env.example backend.mysql.env）
# docker-compose.mysql.yml 通过 env_file 读取本文件。★ 真实密码请改，且不要提交 git。
# =============================================================================

APP_ENV=prod
APP_PORT=8000

# ── 数据库：MySQL（分项组装，DATABASE_URL 留空即可）──
DB_ENABLED=true
DB_DRIVER=mysql
DB_HOST=mysql            # 用 compose 内置 mysql=服务名；外部 MySQL 改成其 IP/host.docker.internal
DB_PORT=3306
DB_NAME=saas_lifecycle
DB_USER=saas_user
DB_PASSWORD=在这里填你的MySQL密码       # ← 必填；与 docker-compose.mysql.yml 的 MYSQL_PASSWORD 一致
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5

# Redis：生产必须使用内网高可用实例；compose 内置服务名为 redis。
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=school-lifecycle
AUTH_SUBJECT_CACHE_TTL=30
HOME_CACHE_TTL=20
TENANT_API_RATE_LIMIT_PER_SECOND=500
USER_API_RATE_LIMIT_PER_SECOND=120
SLOW_QUERY_MS=500
HTTP_SLOW_REQUEST_MS=1000

# 多 worker 时定时扫描只能由独立 scheduler 服务执行。
SCHEDULER_MODE=external

# ── JWT（生产必须换成 ≥32 位强随机值，勿沿用示例）──
JWT_SECRET_KEY=换成32位以上强随机串-勿用示例值-abcdefghij
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS：允许访问的前端来源。同源部署（经 nginx）可只留服务器地址；按需增删 ──
CORS_ORIGINS=http://服务器IP,http://服务器域名

# ── 文件与审计 ──
UPLOAD_DIR=./uploads
AUDIT_ENABLED=true

# ── 多租户 ──
TENANCY_MODE=multi
DEFAULT_TENANT_CODE=demo
