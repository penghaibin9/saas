# 2U4G Linux + systemd 非容器部署。复制到 /etc/school-lifecycle/backend.env，权限 600。
DEPLOYMENT_MODE=production
APP_ENV=production
DEBUG=false
MOCK_LOGIN_ENABLED=false
DB_ENABLED=true
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=saas_lifecycle
DB_USER=saas_user
DB_PASSWORD=替换为数据库强密码
DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
REDIS_URL=redis://default:替换为Redis强密码@127.0.0.1:6379/0
REDIS_KEY_PREFIX=school-lifecycle
JWT_SECRET=替换为至少32位随机密钥
JWT_ALG=HS256
# 兼容旧名（勿与主配置冲突）：JWT_SECRET_KEY / JWT_ALGORITHM
JWT_EXPIRES_IN=7200
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://替换为正式域名
TRUSTED_PROXY_IPS=127.0.0.1,::1
TENANCY_MODE=multi
DEFAULT_TENANT_CODE=demo
SCHEDULER_MODE=external
WEB_CONCURRENCY=1
MULTI_INSTANCE=false
SANDBOX_AUTO_RESET=false
INTERNAL_OPS_TOKEN=替换为运维探针长随机串
SUPPORT_CONTACT=请配置学校或平台运维联系方式
UPLOAD_DIR=/opt/school-lifecycle/shared/uploads
EXPORT_DIR=/opt/school-lifecycle/shared/exports
AUDIT_ENABLED=true
FILE_STORAGE_BACKEND=local
FILE_ALLOW_ZIP=false
SMS_ENABLED=false
