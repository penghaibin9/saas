# 2U4G Linux + systemd 非容器部署。复制到 /etc/school-lifecycle/backend.env，权限 600。
# 这里只放占位值；真实密钥禁止提交 Git。上线前必须跑 scripts/deploy/preflight-linux.sh。
DEPLOYMENT_MODE=production
APP_ENV=production
DEBUG=false
MOCK_LOGIN_ENABLED=false
DB_ENABLED=true
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=saas_lifecycle
DB_USER=saas_user
DB_PASSWORD=替换为数据库强密码
DATABASE_URL=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# 本示例的 systemd 单机部署使用同机 Redis；若改用腾讯云 Redis，请替换为内网地址，
# 并把 ALLOW_LOCAL_REDIS_IN_PRODUCTION 改为 false。密码中的特殊字符必须 URL 编码。
REDIS_URL=redis://default:替换为Redis强密码@127.0.0.1:6379/0
REDIS_KEY_PREFIX=school-lifecycle:prod
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
ALLOW_LOCAL_REDIS_IN_PRODUCTION=true

JWT_SECRET=替换为至少32位随机JWT密钥
JWT_ALG=HS256
JWT_EXPIRES_IN=7200
REFRESH_TOKEN_EXPIRE_DAYS=7
# 与 JWT 完全独立；必须是 Fernet.generate_key() 生成的 32-byte urlsafe-base64 key。
# 不能用“任意 32 位字符串”冒充，否则首个敏感字段加解密才会现场失败。
FIELD_ENCRYPTION_KEY=替换为独立Fernet密钥

# 学校正式访问源，只填 origin（禁止 /api、路径、尾随子目录）。统一发布会把它注入 miniapp H5，
# 避免 miniapp/.env 未随 release 复制时生产包静默回退 http://localhost:8000。
PUBLIC_BASE_URL=https://替换为正式域名
CORS_ORIGINS=https://替换为正式域名
TRUSTED_PROXY_IPS=127.0.0.1,::1
TENANCY_MODE=multi
DEFAULT_TENANT_CODE=替换为试点学校编码
SCHEDULER_MODE=external
# systemd 服务实际启动 2 个 Uvicorn worker，配置必须与启动命令一致，确保 Redis/调度安全闸门生效。
WEB_CONCURRENCY=2
MULTI_INSTANCE=true
INTERNAL_OPS_TOKEN=替换为至少24位运维探针随机串
SUPPORT_CONTACT=请配置学校或平台运维联系方式

UPLOAD_DIR=/opt/school-lifecycle/shared/uploads
EXPORT_DIR=/opt/school-lifecycle/shared/exports
AUDIT_ENABLED=true

# 文件存储：单机试点可先 local，但 uploads 必须进入备份；正式 SaaS 建议启用 cos。
FILE_STORAGE_BACKEND=local
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
FILE_ALLOW_ZIP=false

# 生产对 Office/Excel/ZIP/CSV 等高风险附件强制 fail-closed。
# clamd 必须先运行；独立 school-lifecycle-file-scan.service 会持续消费扫描队列。
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_UNIX_SOCKET=
CLAMAV_CONNECT_TIMEOUT=2
CLAMAV_READ_TIMEOUT=30
FILE_SCAN_MAX_ATTEMPTS=5
FILE_SCAN_RETRY_BASE_SECONDS=30
FILE_SCAN_STALE_LOCK_SECONDS=600
FILE_SCAN_BATCH_SIZE=10
FILE_SCAN_POLL_SECONDS=2

# 短信未开通时保持 false；启用后必须补齐供应商密钥、签名和模板。
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_PASSWORD_RESET=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_REGION=ap-guangzhou
SMS_REQUEST_TIMEOUT_SECONDS=5

# 官网 /contact 商务咨询：访客表单不写业务数据库，直接调用短信 provider 通知商务联系人。
# 正式启用时 SMS_PROVIDER=tencent，并在腾讯云审核一个 5 变量模板：
# {1}=学校 {2}=联系人 {3}=访客电话 {4}=意向产品 {5}=留言摘要。
SMS_TEMPLATE_WEBSITE_LEAD=
WEBSITE_LEAD_NOTIFY_PHONE=13549666867
WEBSITE_LEAD_RATE_LIMIT_PER_HOUR=6
# 仅用于把来源 IP 做不可逆摘要后在 Redis 限流；生产必须替换独立随机盐，禁止填手机号/姓名等 PII。
WEBSITE_LEAD_RATE_SALT=替换为至少32位独立随机串
