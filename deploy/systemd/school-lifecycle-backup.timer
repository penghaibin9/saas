[Unit]
Description=Schedule School Lifecycle verified backup

[Timer]
# Exact six-hour cadence: 01:15 / 07:15 / 13:15 / 19:15. Do not add randomized
# delay here because the production RPO contract is <= 6h.
OnCalendar=*-*-* 01,07,13,19:15:00
Persistent=true
AccuracySec=1s
Unit=school-lifecycle-backup.service

[Install]
WantedBy=timers.target
