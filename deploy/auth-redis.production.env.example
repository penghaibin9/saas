# 生产环境示例。复制到服务器受保护的环境文件后替换所有 REPLACE_ME；禁止提交真实密码或密钥。
APP_ENV=production
DEPLOYMENT_MODE=production
DEBUG=false
DB_ENABLED=true
MOCK_LOGIN_ENABLED=false

# 推荐使用腾讯云 Redis 内网地址。启用 TLS 的实例使用 rediss://；密码需要 URL 编码。
REDIS_URL=rediss://:REPLACE_ME@redis.internal.example:6380/0
REDIS_KEY_PREFIX=school-lifecycle:prod
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# 多 worker / 多实例时，登录失败计数、锁定、refresh token 与验证码都依赖同一 Redis。
MULTI_INSTANCE=true
WEB_CONCURRENCY=2
SCHEDULER_MODE=external

# 单机私有化且 Redis 确实与应用同机时才允许打开；SaaS 正式环境应保持 false。
ALLOW_LOCAL_REDIS_IN_PRODUCTION=false

# 其余生产密钥仍须由服务器密钥管理或受保护环境文件注入。
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
INTERNAL_OPS_TOKEN=REPLACE_WITH_RANDOM_TOKEN
