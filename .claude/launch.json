{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-c", "import os; os.chdir('backend'); import uvicorn; uvicorn.run('app.main:app', host='127.0.0.1', port=8000)"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "miniapp-h5",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "miniapp", "run", "dev:h5"],
      "port": 5188,
      "autoPort": true
    }
  ]
}
