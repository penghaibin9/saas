{
  "name": "yueke-official-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5210 --strictPort",
    "build": "node scripts/check-showcase-assets.mjs --required && vite build && vite build --ssr src/entry-server.js --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5210 --strictPort",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "vue": "3.5.39", "vue-router": "4.6.4" },
  "devDependencies": { "@vitejs/plugin-vue": "5.2.4", "@vue/server-renderer": "3.5.39", "vite": "6.4.3" }
}
