# Copy to a private configuration directory; never place real credentials in this file.
# Dedicated database/user required. Do not use the student database or root account.
WEBSITE_DATABASE_URL=
WEBSITE_ORIGIN=https://www.hnyueke.com
WEBSITE_NEWS_ORIGIN=https://www.hnyueke.com
# Enable only after the old queue is stopped and transfer has been verified.
WEBSITE_NEWS_WORKER_ENABLED=false
WEBSITE_SMS_ENABLED=false
WEBSITE_LEAD_RATE_SALT=
# Enable only with a migrated dedicated database, an active website superadmin,
# a private Fernet key, approved privacy notice and a running expiry worker.
WEBSITE_CONSULTATION_ENABLED=false
WEBSITE_CONSULTATION_KEY=
