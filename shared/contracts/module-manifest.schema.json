{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.school-lifecycle/contracts/module-manifest.schema.json",
  "title": "ModuleManifest",
  "type": "object",
  "required": ["manifestVersion", "schemaVersion", "modules"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "generatedBy": { "type": "string" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "moduleKey",
          "schoolGroup",
          "featureKey",
          "permissionPrefix",
          "frontendRoutePrefixes",
          "backendApiPrefixes",
          "dataOwner",
          "dependencies",
          "entitlementRequired",
          "schoolVisible",
          "platformOnly"
        ],
        "additionalProperties": true,
        "properties": {
          "moduleKey": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-zA-Z0-9]*$" },
          "label": { "type": "string", "minLength": 1 },
          "schoolGroup": { "type": "string", "minLength": 1 },
          "featureKey": { "type": "string", "minLength": 1 },
          "permissionPrefix": { "type": "string", "minLength": 1 },
          "frontendRoutePrefixes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "backendApiPrefixes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^/api/" }
          },
          "dataOwner": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "entitlementRequired": { "type": "boolean" },
          "schoolVisible": { "type": "boolean" },
          "platformOnly": { "type": "boolean" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
