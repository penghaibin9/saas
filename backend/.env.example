# ═══ FastAPI 后端环境变量示例（复制为 .env 使用；只放示例值，禁止放生产密钥）═══
APP_NAME=高校学生全生命周期管理平台 · 后端
APP_ENV=development
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ── 数据库（默认关闭：不连接、不建表、不删表）──
DB_ENABLED=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/student_lifecycle
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# ── JWT（mock 阶段非生产安全实现；生产必须换随机密钥）──
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5188

# ── 文件与审计 ──
UPLOAD_DIR=./uploads
AUDIT_ENABLED=true

# ── 多租户 ──
TENANCY_MODE=single
DEFAULT_TENANT_CODE=demo

# 旧 Node/Express 环境变量已随残留归档至 backend/_legacy_node_express/
