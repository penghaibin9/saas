# ── 服务 ──
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── 数据库（MySQL）──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=school_lifecycle
DB_POOL_LIMIT=10

# ── 多租户（single=私有化单校 / multi=SaaS 一校一库）──
TENANCY_MODE=single
MASTER_DB_NAME=
DEFAULT_TENANT_CODE=default
# 读写分离（可选）：配置后只读查询走副本
DB_READ_HOST=

# ── 认证 ──
# 生产环境必须 >=32 位随机串，否则拒绝启动
JWT_SECRET=school-lifecycle-dev-secret-change-me-please-32
JWT_EXPIRES_IN=7d

# ── 平台运营控制台（跨租户，独立令牌）──
PLATFORM_ADMIN_TOKEN=

# ── CORS（逗号分隔白名单；留空开发放开）──
CORS_ORIGIN=

# ── 口令算法（bcrypt / sm3 国密）──
PASSWORD_ALGO=bcrypt
BCRYPT_ROUNDS=10
