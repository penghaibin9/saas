# ═══ FastAPI 后端环境变量示例（复制为 .env 使用；只放示例值，禁止放生产密钥）═══
APP_NAME=高校学生全生命周期管理平台 · 后端
APP_ENV=development
DEPLOYMENT_MODE=local
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ── 数据库（MySQL-only：正式统一 MySQL utf8mb4）──
# DB_ENABLED=false 时部分演示链路可不连库；生产必须 true。
DB_ENABLED=false
#
# 【正式 · MySQL（默认，开发/测试/部署统一）】把 DATABASE_URL 留空，用下面分项组装：
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_lifecycle_dev
DB_USER=saas_user
# DB_PASSWORD 在此填你的 MySQL 密码（禁止提交到 git；示例文件请留空）
DB_PASSWORD=
#
# 【或 · 直接给连接串（最高优先级，覆盖上面分项）】
# DATABASE_URL=mysql+pymysql://saas_user:你的密码@127.0.0.1:3306/student_lifecycle_dev?charset=utf8mb4
DATABASE_URL=
#
# 测试库标准 = MySQL student_lifecycle_test（pytest 的 db_mode 用；密码经 .env 注入）
TEST_DATABASE_URL=mysql+pymysql://saas_user:你的密码@127.0.0.1:3306/student_lifecycle_test?charset=utf8mb4
#
# 【legacy · 仅历史临时演示，勿当正式验收】
#   SQLite： DB_DRIVER=sqlite / DB_SQLITE_PATH=./data/dev.db（旧 data/dev.db 保留不删）
#   Postgre：DATABASE_URL=postgresql+psycopg://user:pwd@127.0.0.1:5432/student_lifecycle（历史兼容）
#   跑 legacy sqlite 测试：export TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# ── JWT（生产必须换 ≥32 位随机密钥；主配置名 JWT_SECRET / JWT_ALG）──
JWT_SECRET=school-lifecycle-dev-secret-change-me-please-32
JWT_ALG=HS256
# 兼容旧名（勿与主配置冲突）：JWT_SECRET_KEY / JWT_ALGORITHM
JWT_EXPIRES_IN=7200
REFRESH_TOKEN_EXPIRE_DAYS=7

# 运维探针（生产必填）：/health/ready、/internal/metrics
INTERNAL_OPS_TOKEN=
SUPPORT_CONTACT=
SCHEDULER_MODE=web
WEB_CONCURRENCY=1
FILE_ALLOW_ZIP=false

# ── 演示登录开关 ──
# 留空 = 非生产开、生产关（推荐）；显式 false 可强制关闭。
# APP_ENV=production 时禁止显式 true（启动检查会拒绝）。
# 关闭后 /api/v1/auth/mock-login 返回 403，不签发任何令牌。
# 生产演示请用真实账号：demo-school(admin/teacher/student·123456·只读)
#                    sandbox-school(admin2/teacher2/student2·123456·每晚0点重置)
MOCK_LOGIN_ENABLED=

# ── 双真实租户演示体系 ──
# 正式演示租户 demo-school 只读锁（写操作 403）；默认开，false 临时放开。
DEMO_TENANT_READONLY=
# 体验沙箱每晚 0 点自动重置（进程内定时，单实例适用）；默认开。
# 多实例部署请置 false 并用 cron 执行：python scripts/reset_sandbox_school.py --confirm
SANDBOX_AUTO_RESET=

# ── DEBUG（生产必须 false，启动检查强制）──
DEBUG=true

# ── CORS ──
# 生产要求：不允许 *，必须显式白名单（启动检查强制）。
# 5173 管理端；5188 历史兼容；5199 学生 PC 门户
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5188,http://localhost:5189,http://localhost:5190,http://localhost:5199,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5188,http://127.0.0.1:5189,http://127.0.0.1:5190,http://127.0.0.1:5199

# ── 文件与审计 ──
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
AUDIT_ENABLED=true

# ── 文件存储后端 ──
# local（默认）：字节存服务器本地 UPLOAD_DIR，单机部署够用。
# cos          ：字节存腾讯云对象存储 COS，多机/上云部署用。切到 cos 需：
#   1) pip install cos-python-sdk-v5
#   2) 腾讯云控制台建 COS 桶、生成 SecretId/SecretKey，填下方四项
#   3) 历史文件用 python scripts/migrate_files_to_cos.py 迁移
# 切换只改本项，t_file_object 表零迁移。
FILE_STORAGE_BACKEND=local
# COS_REGION=ap-guangzhou
# COS_BUCKET=student-files-1250000000
# COS_SECRET_ID=          # 腾讯云访问密钥，仅填本机 .env，切勿提交进仓库
# COS_SECRET_KEY=         # 腾讯云访问密钥，仅填本机 .env，切勿提交进仓库

# ── 多租户 ──
TENANCY_MODE=single
DEFAULT_TENANT_CODE=demo

# ── 短信/通知（P13-B；默认关闭，测试环境永不真实发送）──
# SMS_ENABLED=true 才会真实发送；缺省/false 只记录 SKIPPED
SMS_ENABLED=false
SMS_PROVIDER=mock          # mock / aliyun / tencent
SMS_ACCESS_KEY_ID=         # 真实密钥仅本地 .env 注入，禁止进 git
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_TODO=
SMS_TEMPLATE_REJECTED=
SMS_TEMPLATE_WARNING=
SMS_RATE_LIMIT_PER_MINUTE=30
SMS_MAX_RETRY=2

# 旧 Node/Express 环境变量已随残留归档至 backend/_legacy_node_express/
