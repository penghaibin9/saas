# ═══ FastAPI 后端环境变量示例（复制为 .env 使用；只放示例值，禁止放生产密钥）═══
APP_NAME=高校学生全生命周期管理平台 · 后端
APP_ENV=development
APP_PORT=8000
API_V1_PREFIX=/api/v1

# ── 数据库 ──
# DB_ENABLED=false 时全部走 mock；上线演示请置 true。
DB_ENABLED=false
#
# 【方式一 · 本地 dev（默认，保留 SQLite）】
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=./data/dev.db
#
# 【方式二 · 部署演示 MySQL（推荐）】把 DATABASE_URL 留空，用下面分项组装：
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=saas_lifecycle
# DB_USER=saas_user
# DB_PASSWORD=在此填你的MySQL密码（禁止提交到 git）
#
# 【方式三 · 直接给连接串（最高优先级，覆盖上面的分项）】
# DATABASE_URL=mysql+pymysql://saas_user:PASSWORD@127.0.0.1:3306/saas_lifecycle?charset=utf8mb4
DATABASE_URL=
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# ── JWT（mock 阶段非生产安全实现；生产必须换随机密钥）──
# 生产要求：APP_ENV=production 时，弱/默认密钥或长度 <32 会拒绝启动。
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── 演示登录开关 ──
# 留空 = 非生产开、生产关（推荐）；显式 false 可强制关闭。
# APP_ENV=production 时禁止显式 true（启动检查会拒绝）。
# 关闭后 /api/v1/auth/mock-login 返回 403，不签发任何令牌。
MOCK_LOGIN_ENABLED=

# ── DEBUG（生产必须 false，启动检查强制）──
DEBUG=true

# ── CORS ──
# 生产要求：不允许 *，必须显式白名单（启动检查强制）。
CORS_ORIGINS=http://localhost:5173,http://localhost:5188

# ── 文件与审计 ──
UPLOAD_DIR=./uploads
AUDIT_ENABLED=true

# ── 多租户 ──
TENANCY_MODE=single
DEFAULT_TENANT_CODE=demo

# 旧 Node/Express 环境变量已随残留归档至 backend/_legacy_node_express/
