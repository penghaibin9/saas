+        raise AppException("VALIDATION_ERROR", "请刷新评价任务后提交有效的预期安置快照")
+    if int(expected) != int(placement_id):
+        raise AppException("DATA_CONFLICT", "实习安置已变化，请刷新后针对当前岗位重新评价")
+
