--- /dev/null
+++ b/scripts/check/selected_pytest_shards.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Freeze a selected test-file union, run isolated shards and fail closed on receipts.
+
+Does not alter the existing selector or relax any assertion. All subprocess arguments
+are arrays; receipts preserve non-zero exit codes, missing JUnit and interrupted runs.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+from list_pytest_shard import shard_for
+
+
+def digest(files):
+    return hashlib.sha256(("\n".join(sorted(files))+"\n").encode()).hexdigest()
+
+
+def make_plan(files, sha, count):
+    files = sorted(set(files))
+    if not files or not 1 <= count <= 32:
+        raise ValueError("empty test union or invalid shard count")
+    if any(not f.startswith("tests/") or ".." in Path(f).parts or not f.endswith(".py") for f in files):
+        raise ValueError("only explicit backend/tests Python files are allowed")
+    shards = [{"id": i, "files": [f for f in files if shard_for(f, count) == i]} for i in range(count)]
+    shards = [s for s in shards if s["files"]]
+    return {"schema": 1, "sha": sha, "files": files, "unionHash": digest(files), "shards": shards}
+
+
+def verify(plan, receipts):
+    expected = {s["id"]: s["files"] for s in plan["shards"]}
+    seen = set()
+    errors = []
+    union = []
+    for receipt in receipts:
+        sid = receipt.get("shard")
+        if sid not in expected or sid in seen:
+            errors.append("duplicate or unknown shard receipt")
+            continue
+        seen.add(sid)
+        files = receipt.get("files", [])
+        union.extend(files)
+        if files != expected[sid] or receipt.get("sha") != plan["sha"] or receipt.get("unionHash") != plan["unionHash"]:
+            errors.append(f"shard {sid}: test union / SHA mismatch")
+        if receipt.get("exitCode") != 0 or receipt.get("junitValid") is not True:
+            errors.append(f"shard {sid}: failed, timed out or incomplete JUnit")
+        if receipt.get("failures", 0) or receipt.get("errors", 0) or receipt.get("tests", 0) <= 0:
+            errors.append(f"shard {sid}: failing or empty test result")
+    if seen != set(expected) or sorted(union) != plan["files"] or len(union) != len(set(union)):
+        errors.append("missing, duplicated or reduced test coverage")
+    return errors
+
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument("action",choices=("plan","run","verify"))
+    ap.add_argument("--plan",type=Path,required=True); ap.add_argument("--out",type=Path)
+    ap.add_argument("--shard",type=int); ap.add_argument("--count",type=int,default=4)
+    ap.add_argument("--budget",type=int,default=3300); ap.add_argument("--full",action="store_true")
+    args=ap.parse_args()
+    sha=subprocess.check_output(["git","rev-parse","HEAD"],text=True).strip()
+    if args.action=="plan":
+        if args.full:
+            files=sorted(p.as_posix() for p in Path("tests").rglob("test_*.py"))
+        else:
+            selector=Path(__file__).with_name("select_pytest_targets.py")
+            files=subprocess.check_output([sys.executable,str(selector)],text=True).split()
+        if any(not Path(f).is_file() for f in files):
+            raise SystemExit("selected file missing")
+        plan=make_plan(files,sha,args.count)
+        args.plan.parent.mkdir(parents=True,exist_ok=True)
+        args.plan.write_text(json.dumps(plan,indent=2)+"\n")
+        matrix={"include":[{"shard":s["id"]} for s in plan["shards"]]}
+        print(json.dumps(matrix,separators=(",",":")))
+        return 0
+    plan=json.loads(args.plan.read_text())
+    if plan["sha"] != sha:
+        raise SystemExit("plan belongs to another checked-out SHA")
+    if args.action=="verify":
+        if not args.out: ap.error("--out required")
+        receipts=[json.loads(p.read_text()) for p in args.out.rglob("receipt.json")]
+        errors=verify(plan,receipts)
+        print(json.dumps({"passed":not errors,"sha":sha,"errors":errors,"shards":len(receipts)},indent=2))
+        return 1 if errors else 0
+    if not args.out or args.shard is None: ap.error("--out and --shard required")
+    matches=[s for s in plan["shards"] if s["id"]==args.shard]
+    if len(matches)!=1: raise SystemExit("unknown shard")
+    files=matches[0]["files"]
+    args.out.mkdir(parents=True,exist_ok=True)
+    junit=args.out/"junit.xml"
+    junit.unlink(missing_ok=True)
+    receipt={"sha":sha,"unionHash":plan["unionHash"],"shard":args.shard,"files":files,
+             "exitCode":None,"junitValid":False,"startedAt":time.time()}
+    cmd=[sys.executable,"-m","pytest",*files,"-q","-p","no:warnings","--durations=20",f"--junitxml={junit}"]
+    receipt["command"]=cmd
+    try:
+        # Separate runner/MySQL per shard: do not share a mutable test schema.
+        with (args.out/"pytest.log").open("w") as log:
+            result=subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,timeout=args.budget,check=False)
+        receipt["exitCode"]=result.returncode
+    except subprocess.TimeoutExpired:
+        receipt["exitCode"]=124
+    finally:
+        try:
+            root=ET.parse(junit).getroot()
+            suites=[root] if root.tag=="testsuite" else list(root.iter("testsuite"))
+            for key in ("tests","failures","errors","skipped"):
+                receipt[key]=sum(int(s.attrib.get(key,0)) for s in suites)
+            receipt["junitValid"]=bool(suites) and receipt["tests"]>0
+        except (OSError,ValueError,ET.ParseError):
+            pass
+        receipt["finishedAt"]=time.time()
+        (args.out/"receipt.json").write_text(json.dumps(receipt,indent=2)+"\n")
+    print(json.dumps(receipt,indent=2))
+    if receipt["exitCode"]!=0: return receipt["exitCode"] or 1
+    return 0 if receipt["junitValid"] else 1
+
+if __name__=="__main__": raise SystemExit(main())
