{
  "name": "yueke-internship-standalone-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:routes": "node scripts/check-standalone-routes.mjs",
    "check:imports": "node scripts/check-standalone-imports.mjs",
    "test:employment": "node --test tests/employment.behavior.test.mjs",
    "test:teacher-reports": "node --test tests/teacher-reports.behavior.test.mjs",
    "test:basic-info": "node --test tests/basic-info.behavior.test.mjs",
    "test:attendance-photo": "node --test tests/attendance-photo.behavior.test.mjs",
    "test:teacher-checkin-rule": "node --test tests/teacher-checkin-rule.behavior.test.mjs",
    "test:teacher-checkin-history": "node --test tests/teacher-checkin-history.behavior.test.mjs",
    "test:materials": "node --test tests/material-requirements.behavior.test.mjs tests/workspace-navigation.behavior.test.mjs",
    "prebuild": "npm run check:routes && npm run check:imports"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vant/area-data": "^2.1.0",
    "cos-js-sdk-v5": "1.10.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "pdfjs-dist": "6.2.108",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.7"
  },
  "overrides": {
    "fast-xml-parser": "5.7.2",
    "postcss": "8.5.23",
    "nanoid": "3.3.18"
  }
}
