# Copy to .env.production on the deployment host. Never commit real secrets.
COMPOSE_PROJECT_NAME=yueke-internship

DB_NAME=internship_standalone
DB_USER=internship_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_MAX_CONNECTIONS=500
MYSQL_INNODB_BUFFER_POOL_SIZE=4G

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb

JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_OR_APP_SUPPORTED_KEY
SENSITIVE_SEARCH_HMAC_KEY=CHANGE_ME_RANDOM_HMAC_KEY

WEB_CONCURRENCY=4
EXPECTED_ALEMBIC_REVISION=ix0023
FILE_STORAGE_DIR=/data/files

HTTPS_PORT=443
HTTP_PORT=80
TLS_CERT_FILE=./certs/fullchain.pem
TLS_KEY_FILE=./certs/privkey.pem
