# Copy to .env.production on the deployment host. Never commit real secrets.
COMPOSE_PROJECT_NAME=yueke-internship
# First installation may leave this blank. Enable attendance only after the
# explicit school and RUNNING batch below exist; delivery checks require it.
COMPOSE_PROFILES=
ATTENDANCE_TENANT_ID=
ATTENDANCE_BATCH_ID=
ATTENDANCE_INTERVAL_SECONDS=60
# HTTPS public address ending in /enterprise, matching the bundled reverse proxy.
# Empty is installable but cannot qualify as a completed delivery configuration.
ENTERPRISE_PORTAL_BASE_URL=

DB_NAME=internship_standalone
DB_USER=internship_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_MAX_CONNECTIONS=500
MYSQL_INNODB_BUFFER_POOL_SIZE=4G

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb

JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_OR_APP_SUPPORTED_KEY
SENSITIVE_SEARCH_HMAC_KEY=CHANGE_ME_RANDOM_HMAC_KEY

WEB_CONCURRENCY=4
EXPECTED_ALEMBIC_REVISION=ix0036
FILE_STORAGE_DIR=/data/files
# Optional deployer-owned receipts, mounted read-only into the backend.
SYSTEM_EVIDENCE_DIR=
RELEASE_VERSION=
RELEASE_COMMIT=

HTTPS_PORT=443
HTTP_PORT=80
TLS_CERT_FILE=./certs/fullchain.pem
TLS_KEY_FILE=./certs/privkey.pem
