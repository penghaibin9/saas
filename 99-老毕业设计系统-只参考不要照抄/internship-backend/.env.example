PORT=3000

# 运行环境：production 时会强制要求安全的 JWT_SECRET，并隐藏错误细节
NODE_ENV=development

# ═══════════ 必填：数据库 + JWT（不配跑不起来）═══════════
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=internship_management
# Windows 若 mysql/mysqldump 不在 PATH，可填写完整路径；Linux/Docker 通常留空
MYSQL_BIN=
MYSQLDUMP_BIN=

# JWT（生产环境必须 >=32 位随机串：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ───────── 部署模式（同一套代码两用）─────────
# single = 私有化单库（默认）；multi = SaaS，按学校路由到各自独立库（DB-per-tenant）
TENANCY_MODE=single
MASTER_DB_NAME=
DEFAULT_TENANT_CODE=default
# 开通一所学校：npm run provision <code> "<学校名称>" [adminUser] [adminPass]
# 全租户迁移（30 校升级用）：node scripts/migrate-all-tenants.js

# ───────── SaaS 平台运营控制台（multi 模式）─────────
# 平台运营管理员令牌（凭此访问 /api/platform/*；不配=控制台关闭。建议同时用 nginx 限内网）
PLATFORM_ADMIN_TOKEN=

# ───────── 连接池治理（30+ 校建议调优）─────────
DB_POOL_LIMIT=10          # 单库连接数（30+ 校建议下调到 5）
POOL_IDLE_MS=300000       # 租户库连接池空闲多久(ms)后回收，默认 5 分钟
POOL_SWEEP_MS=60000       # 空闲池扫描周期(ms)

# 允许的前端来源（逗号分隔），留空=放开所有（仅建议开发环境）
# 例：CORS_ORIGIN=http://localhost:5173,https://your-domain.com
CORS_ORIGIN=

# 系统对外访问根 URL（HTTPS，CAS 回调用）
APP_PUBLIC_URL=
# CAS 登录成功后的跨域回跳 origin 白名单（逗号分隔）；留空时仅允许本站 / 相对路径
CAS_RETURN_TO_ALLOWLIST=

# 初始管理员密码（npm run seed 用；生产建议传强随机密码，首登仍强制改密）
INITIAL_ADMIN_PASSWORD=

# ═══════════ AI 能力（DeepSeek）═══════════
# 不配 = 演示降级（结果标 isDemo，不阻断）。答辩前建议配上让 AI 现场真跑。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_MS=60000
# AI 月度调用配额（防账单失控）；0 或留空=不限，超额自动降级演示
AI_MONTHLY_QUOTA=0

# ═══════════ 消息触达（可选，不配则该渠道静默跳过）═══════════
# 微信小程序订阅消息
WX_MP_APPID=
WX_MP_SECRET=
WX_TEMPLATE_NOTIFY=
# 短信（aliyun|tencent）
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 邮件（懒加载 nodemailer，需 npm install）
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# 群机器人（错误告警 + 群通知，任配其一）
WECOM_WEBHOOK=
DINGTALK_WEBHOOK=
DINGTALK_KEYWORD=实习

# ═══════════ 对象存储（多实例/容器必配，单机可不配）═══════════
# local（默认，存本地磁盘）/ oss（阿里云）/ s3（AWS，需 npm install 对应 SDK）
STORAGE_DRIVER=local
# OSS：
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE=
# S3：
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE=
S3_ENDPOINT=

# ═══════════ 规模化 / 多实例（PM2 cluster 时建议配）═══════════
# Redis：配了①登录限流多实例共享配额 ②SSE 实时推送跨实例广播（需 npm install ioredis）
#   不配=内存限流 + SSE 单进程本地推送（单实例足够；多实例务必配）
REDIS_URL=
# 只读副本主机（读写分离，V2）：配了之后大屏/统计等只读查询走副本分担主库；不配=读走主库
DB_READ_HOST=

# ═══════════ 可观测 / 告警（可选）═══════════
# 错误告警：=1 且配了群机器人时，error 级日志推送到群（60s 节流）
ALERT_ON_ERROR=0
# /metrics 端点保护令牌（留空=不保护，内网抓取可不设）
METRICS_TOKEN=
# Sentry 错误采集（需 npm install @sentry/node）
SENTRY_DSN=
SENTRY_TRACES_RATE=0
# 日志级别：debug|info|warn|error（默认 info）
LOG_LEVEL=info

# ═══════════ 信创 / 合规（可选）═══════════
# 口令哈希：bcrypt（默认）| sm3（国密，需 npm install sm-crypto；按哈希前缀自动识别，新旧共存）
PASSWORD_ALGO=bcrypt
# 数据报送上报网关（省级/国家平台对接预留）；不配=演示预览
REPORTING_PUSH_URL=
REPORTING_PUSH_KEY=

# ═══════════ 打卡反作弊阈值（可选，有默认值）═══════════
# 定位精度超过此值(米)视为可疑
CHECKIN_ACCURACY_WARN=1000
# 与上次打卡推算时速超过此值(km/h)视为位移突变作弊
CHECKIN_SPEED_LIMIT=250

# ───────── 定时任务 ─────────
# 保险到期提前预警天数（默认 15）
INSURANCE_WARN_DAYS=15
