<view class="page">
  <button wx:if="{{isTeacher}}" class="btn" bindtap="openForm">＋ 下达任务书</button>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <view wx:else class="card">
    <view class="sec-t" style="margin-top:0">{{isTeacher ? '已下达任务书' : '我的任务书'}}</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="detail">
        <view>
          <view class="m">{{isTeacher ? item.student_name : item.title}}</view>
          <view class="d">{{isTeacher ? item.title : (item.teacher_name || '')}} · {{item.dateText}}</view>
        </view>
        <view class="right">
          <text class="tag {{item.confirmed ? 'tag-g' : 'tag-y'}}">{{item.confirmed ? '已确认' : '待确认'}}</text>
        </view>
      </view>
      <button wx:if="{{!isTeacher && list[0].canConfirm}}" class="btn" bindtap="confirm">确认任务书</button>
    </block>
    <view wx:else class="empty"><text class="ei">📋</text>{{isTeacher ? '暂未下达，点击上方按钮' : '暂无任务书，请等待指导教师下达'}}</view>
  </view>
</view>

<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">下达毕设任务书</view>
    <text class="field-label">学生</text>
    <picker mode="selector" range="{{students}}" range-key="real_name" value="{{stuIdx}}" bindchange="onStu">
      <view class="input">{{students[stuIdx] ? students[stuIdx].real_name : '请选择'}}</view>
    </picker>
    <text class="field-label">标题</text>
    <input class="input" value="{{fTitle}}" bindinput="onTitle" placeholder="任务书标题" />
    <text class="field-label">内容</text>
    <textarea class="textarea" value="{{fContent}}" bindinput="onContent" placeholder="任务要求、进度安排等" />
    <button class="btn" loading="{{saving}}" bindtap="issue">下达</button>
    <button class="btn btn-o" bindtap="closeForm">取消</button>
  </view>
</view>
