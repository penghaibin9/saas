<view class="page">
  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:50%"></view><view class="sk sk-line" style="width:70%"></view></view>
    <view class="sk-card"><view class="sk sk-line" style="width:45%"></view><view class="sk sk-line" style="width:65%"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <view class="review-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="k"
        class="review-tab {{activeTab === item.k ? 'on' : ''}}"
        data-k="{{item.k}}"
        bindtap="switchTab"
        hover-class="tap-active"
      >{{item.label}}<text wx:if="{{item.count}}" class="nb">{{item.count}}</text></view>
    </view>

    <!-- 待审实习申请 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'apps'}}" id="sec-apps">
      <view class="sec-t" style="margin-top:0">待审实习申请（{{apps.length}}）</view>
      <block wx:if="{{apps.length}}">
        <view class="row" wx:for="{{apps}}" wx:key="id">
          <view>
            <view class="m">{{item.student_name}}</view>
            <view class="d">{{item.position_title}}{{item.enterprise_name ? (' · ' + item.enterprise_name) : ''}}</view>
          </view>
          <view class="right">
            <button class="btn btn-sm" data-id="{{item.id}}" data-agree="{{true}}" bindtap="reviewApp">同意</button>
            <button class="btn btn-sm btn-r" data-id="{{item.id}}" data-agree="{{false}}" bindtap="reviewApp">拒绝</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无待审申请</view>
    </view>

    <!-- 待批周报/月报 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'logs'}}" id="sec-logs">
      <view style="display:flex;justify-content:space-between;align-items:center">
        <view class="sec-t" style="margin-top:0">待批周报/月报（{{logs.length}}）</view>
        <text wx:if="{{logs.length > 1}}" class="link-a" style="font-size:24rpx" bindtap="batchPassLogs">⚡ 一键全部通过</text>
      </view>
      <block wx:if="{{logs.length}}">
        <view class="row" wx:for="{{logs}}" wx:key="id">
          <view bindtap="viewLog" data-id="{{item.id}}">
            <view class="m">{{item.student_name}}·{{item.type === 'monthly' ? '月报' : '周报'}}</view>
            <view class="d link-a">{{item.title}} ›</view>
          </view>
          <view class="right">
            <button class="btn btn-sm" data-id="{{item.id}}" data-agree="{{true}}" bindtap="reviewLog">通过</button>
            <button class="btn btn-sm btn-r" data-id="{{item.id}}" data-agree="{{false}}" bindtap="reviewLog">驳回</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无待批周报</view>
    </view>

    <!-- 换岗/终止待审 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'asg'}}" id="sec-asg">
      <view class="sec-t" style="margin-top:0">换岗/终止待审（{{asgChanges.length}}）</view>
      <block wx:if="{{asgChanges.length}}">
        <view class="row" wx:for="{{asgChanges}}" wx:key="id">
          <view><view class="m">{{item.student_name}} · {{item.change_type === 'transfer' ? '换岗' : '终止'}}</view><view class="d">{{item.reason}}</view></view>
          <button class="btn btn-sm" data-id="{{item.id}}" bindtap="reviewAsg">审批</button>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无换岗/终止申请</view>
    </view>

    <!-- 协议待会签 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'agr'}}" id="sec-agr">
      <view class="sec-t" style="margin-top:0">协议待会签（{{pendingAgreements.length}}）</view>
      <block wx:if="{{pendingAgreements.length}}">
        <view class="row" wx:for="{{pendingAgreements}}" wx:key="id">
          <view><view class="m">{{item.title}}</view><view class="d">{{item.student_name}}</view></view>
          <button class="btn btn-sm" data-id="{{item.id}}" bindtap="teacherSignAgreement">会签</button>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无待会签协议</view>
    </view>

    <!-- 待批请假 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'leaves'}}" id="sec-leaves">
      <view class="sec-t" style="margin-top:0">待批请假（{{leaves.length}}）</view>
      <block wx:if="{{leaves.length}}">
        <view class="row" wx:for="{{leaves}}" wx:key="id">
          <view>
            <view class="m">{{item.student_name}}</view>
            <view class="d">{{item.startText}}~{{item.endText}}（{{item.days}}天） {{item.reason}}</view>
          </view>
          <view class="right">
            <button class="btn btn-sm" data-id="{{item.id}}" data-agree="{{true}}" bindtap="reviewLeave">通过</button>
            <button class="btn btn-sm btn-r" data-id="{{item.id}}" data-agree="{{false}}" bindtap="reviewLeave">驳回</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无待批请假</view>
    </view>

    <!-- 待审成果 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'achs'}}" id="sec-achs">
      <view class="sec-t" style="margin-top:0">待审成果（{{achs.length}}）</view>
      <block wx:if="{{achs.length}}">
        <view class="row" wx:for="{{achs}}" wx:key="id">
          <view>
            <view class="m">{{item.student_name}}</view>
            <view class="d">{{item.title}}</view>
          </view>
          <view class="right">
            <button class="btn btn-sm" data-id="{{item.id}}" data-pass="{{true}}" bindtap="reviewAch">通过</button>
            <button class="btn btn-sm btn-r" data-id="{{item.id}}" data-pass="{{false}}" bindtap="reviewAch">驳回</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无待审成果</view>
    </view>

    <!-- 待评实习报告 -->
    <view class="card" wx:if="{{activeTab === 'all' || activeTab === 'reports'}}" id="sec-reports">
      <view class="sec-t" style="margin-top:0">待评实习报告（{{reports.length}}）</view>
      <block wx:if="{{reports.length}}">
        <view class="row" wx:for="{{reports}}" wx:key="id">
          <view>
            <view class="m">{{item.student_name}}</view>
            <view class="d">{{item.title}}</view>
          </view>
          <view class="right">
            <button class="btn btn-sm" data-item="{{item}}" bindtap="openGrade">评分</button>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">✅</text>暂无待评报告</view>
    </view>
  </block>
</view>

<!-- 周报内容查看 -->
<view wx:if="{{showLog}}" class="mask" bindtap="closeLog">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{logDetail.type === 'monthly' ? '月报' : '周报'}}详情</view>
    <view class="kv"><text class="k">学生</text><text>{{logDetail.student_name}}</text></view>
    <view class="kv"><text class="k">标题</text><text>{{logDetail.title}}</text></view>
    <view class="detail-body">{{logDetail.content || '（无内容）'}}</view>
    <button class="btn" data-id="{{logDetail.id}}" data-agree="{{true}}" bindtap="reviewLog">通过</button>
    <button class="btn btn-r" data-id="{{logDetail.id}}" data-agree="{{false}}" bindtap="reviewLog">驳回</button>
    <button class="btn btn-o" bindtap="closeLog">关闭</button>
  </view>
</view>

<!-- 报告评分 -->
<view wx:if="{{showGrade}}" class="mask" bindtap="closeGrade">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">评阅报告：{{gradeName}}</view>
    <text class="field-label">成绩（0-100）</text>
    <input class="input" type="number" placeholder="如 85" value="{{gScore}}" bindinput="onScore" />
    <view class="qc-row">
      <view class="qc {{gScore == '95' ? 'on' : ''}}" data-v="95" bindtap="onQuickScore">优 95</view>
      <view class="qc {{gScore == '85' ? 'on' : ''}}" data-v="85" bindtap="onQuickScore">良 85</view>
      <view class="qc {{gScore == '75' ? 'on' : ''}}" data-v="75" bindtap="onQuickScore">中 75</view>
      <view class="qc {{gScore == '60' ? 'on' : ''}}" data-v="60" bindtap="onQuickScore">及格 60</view>
    </view>
    <text class="field-label">评语</text>
    <textarea class="textarea" placeholder="评阅意见（可选）" value="{{gCmt}}" bindinput="onCmt" auto-height />
    <view class="qc-row">
      <view class="qc" data-t="内容翔实，结构清晰" bindtap="onQuickCmt">内容翔实，结构清晰</view>
      <view class="qc" data-t="理论联系实际，总结到位" bindtap="onQuickCmt">理论联系实际</view>
      <view class="qc" data-t="格式规范，态度认真" bindtap="onQuickCmt">格式规范，态度认真</view>
      <view class="qc" data-t="深度有待加强" bindtap="onQuickCmt">深度有待加强</view>
    </view>
    <view class="fld-err">{{gErr}}</view>
    <button class="btn" loading="{{gSaving}}" bindtap="submitGrade">提交评阅</button>
    <button class="btn btn-o" bindtap="closeGrade">取消</button>
  </view>
</view>
