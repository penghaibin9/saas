<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:elif="{{!grade}}" class="empty"><text class="ei">🏅</text>暂无成绩，成绩公布后可在此查看</view>

  <block wx:else>
    <view class="card hello" style="background:linear-gradient(135deg,#7C3AED,#0EA5E9)">
      <view class="s">综合总评</view>
      <view class="n" style="font-size:64rpx">{{grade.total_score != null ? grade.total_score : '—'}}</view>
    </view>
    <view class="card">
      <view wx:if="{{grade.topic_title}}" class="kv"><text class="k">选题</text><text>{{grade.topic_title}}</text></view>
      <view class="kv"><text class="k">评阅成绩</text><text>{{grade.review_score != null ? grade.review_score : '—'}}</text></view>
      <view class="kv"><text class="k">答辩成绩</text><text>{{grade.defense_score != null ? grade.defense_score : '—'}}</text></view>
      <view wx:if="{{grade.teacher_name}}" class="kv"><text class="k">指导教师</text><text>{{grade.teacher_name}}</text></view>
      <view wx:if="{{grade.remark}}" class="kv"><text class="k">评语</text><text>{{grade.remark}}</text></view>
    </view>
  </block>
</view>
