<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>

  <!-- 教师/管理员：就业大盘 -->
  <block wx:elif="{{isTeacher}}">
    <view class="flow-summary" style="margin-bottom:16rpx">
      <view>
        <view class="pct">{{stats.rate || 0}}%</view>
        <view class="txt">毕业去向落实率 · 已登记 {{stats.filled || 0}}/{{stats.total || 0}} 人</view>
      </view>
      <view class="tag tag-b">就业大盘</view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">去向分布</view>
      <block wx:if="{{stats.dist.length}}">
        <view class="kv" wx:for="{{stats.dist}}" wx:key="type"><text class="k">{{item.label}}</text><text>{{item.count}} 人</text></view>
      </block>
      <view wx:else class="empty" style="padding:30rpx">暂无去向数据</view>
    </view>
    <view wx:if="{{stats.topCities.length}}" class="card">
      <view class="sec-t" style="margin-top:0">就业城市 Top5</view>
      <view class="kv" wx:for="{{stats.topCities}}" wx:key="city"><text class="k">{{item.city}}</text><text>{{item.count}} 人</text></view>
    </view>
  </block>

  <!-- 学生：去向登记 -->
  <view wx:else class="card">
    <view class="sec-t" style="margin-top:0">毕业去向登记</view>
    <text class="field-label">去向类型</text>
    <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIdx}}" bindchange="onType">
      <view class="input">{{types[typeIdx].label}}</view>
    </picker>
    <text class="field-label">单位名称</text>
    <input class="input" value="{{company}}" bindinput="onCompany" placeholder="就业/升学单位" />
    <text class="field-label">岗位/专业</text>
    <input class="input" value="{{position}}" bindinput="onPosition" />
    <text class="field-label">城市</text>
    <input class="input" value="{{city}}" bindinput="onCity" />
    <text class="field-label">薪资范围</text>
    <input class="input" value="{{salary}}" bindinput="onSalary" placeholder="如 5000-8000" />
    <text class="field-label">备注</text>
    <textarea class="textarea" value="{{remark}}" bindinput="onRemark" />
    <button class="btn" loading="{{saving}}" bindtap="save">{{saved ? '更新去向' : '保存去向'}}</button>
  </view>
</view>
