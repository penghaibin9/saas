<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:else class="card">
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="openDetail">
        <view>
          <view class="m">{{item.title}}</view>
          <view class="d">{{item.category ? ('[' + item.category + '] ') : ''}}{{item.dateText}} · {{item.by}}</view>
        </view>
        <text style="color:#9AA7B8">›</text>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">📢</text>暂无公示公告</view>
  </view>
</view>

<view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{detail.title}}</view>
    <view class="kv"><text class="k">分类</text><text>{{detail.category || '-'}}</text></view>
    <view class="kv"><text class="k">发布</text><text>{{detail.dateText}} · {{detail.by}}</text></view>
    <view class="detail-body">{{detail.content || '（无正文）'}}</view>
    <button class="btn btn-o" bindtap="closeDetail">关闭</button>
  </view>
</view>
