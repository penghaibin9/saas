<view class="page">
  <button class="btn" bindtap="newLog">＋ 写周报 / 月报</button>

  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:70%"></view><view class="sk sk-line" style="width:40%"></view></view>
    <view class="sk-card"><view class="sk sk-line" style="width:60%"></view><view class="sk sk-line" style="width:35%"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <!-- 本周提交状态 -->
    <view wx:if="{{!weeklyDone}}" class="banner banner-warn" style="margin-top:22rpx" bindtap="newLog">
      <text class="bi">⏰</text>
      <view class="bx">本周还没有提交周报，记得按时提交哦</view>
      <text class="ba">去写 ›</text>
    </view>
    <view wx:else class="banner banner-ok" style="margin-top:22rpx">
      <text class="bi">✅</text>
      <view class="bx">本周周报已提交，继续保持</view>
    </view>

    <!-- 统计 -->
    <view class="stat-strip">
      <view class="stat-i"><view class="v">{{stats.total}}</view><view class="l">全部</view></view>
      <view class="stat-i"><view class="v c-y">{{stats.pending}}</view><view class="l">待批阅</view></view>
      <view class="stat-i"><view class="v c-g">{{stats.passed}}</view><view class="l">已通过</view></view>
      <view class="stat-i"><view class="v c-r">{{stats.rejected}}</view><view class="l">已驳回</view></view>
    </view>

    <!-- 筛选 -->
    <view class="chips">
      <view class="chip {{filter === item.k ? 'on' : ''}}" wx:for="{{filters}}" wx:key="k" data-k="{{item.k}}" bindtap="setFilter">{{item.label}}</view>
    </view>

    <view class="card">
      <block wx:if="{{shown.length}}">
        <view class="row" wx:for="{{shown}}" wx:key="id" data-item="{{item}}" bindtap="openDetail">
          <view style="flex:1;min-width:0">
            <view class="m">{{item.typeLabel}}{{item.title}}</view>
            <view class="d">{{item.dateText}}{{item.reject_reason ? (' · 驳回：' + item.reject_reason) : ''}}</view>
            <view wx:if="{{item.teacher_comment}}" class="row-cmt"><text class="who">教师评语：</text>{{item.teacher_comment}}</view>
          </view>
          <view class="right"><text class="tag {{item.statusClass}}">{{item.statusText}}</text> <text style="color:#9AA7B8"> ›</text></view>
        </view>
      </block>
      <view wx:elif="{{list.length}}" class="empty"><text class="ei">🔍</text>该状态下暂无记录</view>
      <view wx:else class="empty"><text class="ei">📝</text>还没有周报/月报，点上方按钮新建</view>
    </view>
  </block>
</view>

<!-- 详情弹层 -->
<view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{detail.type === 'monthly' ? '月报' : '周报'}}详情</view>
    <view class="kv"><text class="k">标题</text><text>{{detail.title}}</text></view>
    <view class="kv"><text class="k">状态</text><text class="tag {{detail.statusClass}}">{{detail.statusText}}</text></view>
    <view wx:if="{{detail.reject_reason}}" class="kv"><text class="k">驳回原因</text><text style="color:#DC2626">{{detail.reject_reason}}</text></view>
    <view wx:if="{{detail.teacher_comment}}" class="kv"><text class="k">教师评语</text><text>{{detail.teacher_comment}}</text></view>
    <view class="detail-body">{{detail.content || '（无内容）'}}</view>

    <block wx:if="{{detail.status === 0}}">
      <button class="btn" bindtap="submit">提交批阅</button>
      <button class="btn btn-o" bindtap="edit">编辑</button>
      <button class="btn btn-r" bindtap="remove">删除</button>
    </block>
    <button wx:elif="{{detail.status === 3}}" class="btn" bindtap="submit">重新提交</button>
    <button class="btn btn-o" bindtap="closeDetail">关闭</button>
  </view>
</view>
