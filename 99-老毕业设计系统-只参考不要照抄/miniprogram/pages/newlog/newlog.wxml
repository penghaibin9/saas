<view class="page">
  <view class="card">
    <view class="seg">
      <view class="seg-i {{type === 'weekly' ? 'on' : ''}}" data-t="weekly" bindtap="setType">周报</view>
      <view class="seg-i {{type === 'monthly' ? 'on' : ''}}" data-t="monthly" bindtap="setType">月报</view>
    </view>

    <text class="field-label">标题</text>
    <input class="input" placeholder="如：第3周实习周报" value="{{title}}" bindinput="onTitle" />

    <view style="display:flex;justify-content:space-between;align-items:center">
      <text class="field-label">内容</text>
      <text class="link-a" style="font-size:24rpx" bindtap="useTemplate">套用模板</text>
    </view>
    <textarea class="textarea" placeholder="本{{type === 'monthly' ? '月' : '周'}}工作内容、收获、问题…（提交需不少于 {{minLen}} 字）" value="{{content}}" bindinput="onContent" auto-height maxlength="5000" />
    <text class="char-count {{contentLen < minLen ? 'warn' : ''}}">{{contentLen}}/5000{{contentLen < minLen ? ('（还差 ' + (minLen - contentLen) + ' 字可提交）') : ''}}</text>

    <text class="field-label">附件（可选）</text>
    <view class="input" bindtap="chooseFile">{{file ? file.name : '点击选择文件'}}</view>

    <view class="fld-err">{{err}}</view>
    <button class="btn" loading="{{saving}}" bindtap="submit">提交批阅</button>
    <button class="btn btn-o" loading="{{savingDraft}}" bindtap="saveDraft">保存草稿</button>
    <button class="btn btn-o" style="border-color:var(--border);color:var(--t2)" bindtap="cancel">取消</button>
    <view wx:if="{{draftSavedAt}}" style="text-align:center;font-size:22rpx;color:var(--t3);margin-top:12rpx">草稿已自动暂存 {{draftSavedAt}}</view>
  </view>
</view>
