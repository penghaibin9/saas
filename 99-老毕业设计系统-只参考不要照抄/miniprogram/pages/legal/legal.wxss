.page { min-height: 100vh; background: #F5F7FA; padding: 24rpx; box-sizing: border-box; }
.tabs { display: flex; background: #fff; border-radius: 16rpx; padding: 8rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx; color: #6B7280; border-radius: 12rpx; }
.tab.on { background: #E6F4FF; color: #1677FF; font-weight: 600; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; color: #374151; }
.h1 { font-size: 38rpx; font-weight: 700; color: #111827; }
.meta { color: #9CA3AF; font-size: 23rpx; margin: 10rpx 0 28rpx; }
.h2 { font-size: 29rpx; font-weight: 600; color: #1F2937; margin: 28rpx 0 10rpx; }
.p { font-size: 26rpx; line-height: 1.8; text-align: justify; }
