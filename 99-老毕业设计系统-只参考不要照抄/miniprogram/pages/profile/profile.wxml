<view class="page">
  <view wx:if="{{force}}" class="card" style="background:#FEF3C7">
    <view style="font-size:26rpx;color:#92400E;line-height:1.7">⚠️ 这是您首次登录，请先设置新密码（需≥6位且含字母和数字）后方可使用其他功能。</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:else>
    <view wx:if="{{!force}}" class="card">
      <view class="kv"><text class="k">用户名</text><text>{{u.username || '-'}}</text></view>
      <view class="kv"><text class="k">角色</text><text>{{u.roleName || '-'}}</text></view>
      <view wx:if="{{u.eeid}}" class="kv"><text class="k">学号/工号</text><text>{{u.eeid}}</text></view>
      <view class="kv"><text class="k">上次登录</text><text>{{u.lastLoginTime || '-'}}</text></view>
    </view>

    <view wx:if="{{!force}}" class="card">
      <view class="sec-t" style="margin-top:0">编辑资料</view>
      <text class="field-label">姓名</text>
      <input class="input" value="{{name}}" bindinput="onName" />
      <text class="field-label">手机号</text>
      <input class="input" type="number" placeholder="未填写" value="{{phone}}" bindinput="onPhone" />
      <text class="field-label">邮箱</text>
      <input class="input" placeholder="未填写" value="{{email}}" bindinput="onEmail" />
      <block wx:if="{{isStudent}}">
        <text class="field-label">技能标签（用于岗位智能推荐）</text>
        <input class="input" placeholder="如：Java,机械设计,新媒体（逗号分隔）" value="{{skillTags}}" bindinput="onSkillTags" />
        <text class="field-label">紧急联系人姓名</text>
        <input class="input" placeholder="家长或监护人" value="{{emergencyName}}" bindinput="onEmName" />
        <text class="field-label">紧急联系人电话</text>
        <input class="input" type="number" placeholder="24小时可联系" value="{{emergencyPhone}}" bindinput="onEmPhone" />
        <text class="field-label">与本人关系</text>
        <input class="input" placeholder="如：父亲、母亲" value="{{emergencyRelation}}" bindinput="onEmRel" />
      </block>
      <view class="fld-err">{{pErr}}</view>
      <button class="btn" loading="{{saving}}" bindtap="saveProfile">保存资料</button>
    </view>

    <view class="card">
      <view class="sec-t" style="margin-top:0">{{force ? '设置新密码' : '修改密码'}}</view>
      <text class="field-label">原密码</text>
      <input class="input" password placeholder="{{force ? '初始密码' : '请输入原密码'}}" value="{{oldPwd}}" bindinput="onOld" />
      <text class="field-label">新密码</text>
      <input class="input" password placeholder="≥6位，含字母和数字" value="{{newPwd}}" bindinput="onNew" />
      <text class="field-label">确认新密码</text>
      <input class="input" password placeholder="再次输入新密码" value="{{newPwd2}}" bindinput="onNew2" />
      <view class="fld-err">{{cErr}}</view>
      <button class="btn" loading="{{changing}}" bindtap="changePwd">{{force ? '提交并进入' : '修改密码'}}</button>
    </view>
  </block>
</view>
