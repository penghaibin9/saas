<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <view wx:else class="card">
    <view class="sec-t" style="margin-top:0">分配给我的质量检查</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id">
        <view>
          <view class="m">{{item.student_name}} <text class="d">{{item.typeText}}</text></view>
          <view class="d">{{item.batch_name}}{{item.achievement_title ? (' · ' + item.achievement_title) : ''}}</view>
        </view>
        <view class="right">
          <block wx:if="{{item.status === 0}}">
            <button class="btn btn-sm" style="margin:0 0 6rpx" data-id="{{item.id}}" bindtap="pass">通过</button>
            <button class="btn btn-sm btn-r" style="margin:0" data-id="{{item.id}}" bindtap="reject">驳回</button>
          </block>
          <text wx:else class="tag {{item.statusClass}}">{{item.statusText}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">🔎</text>暂无质量检查任务</view>
  </view>
</view>
