<view class="page">
  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:50%"></view></view>
    <view class="sk-card"><view class="sk sk-line" style="width:70%"></view><view class="sk sk-line" style="width:45%"></view></view>
  </block>
  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>
  <block wx:else>
    <view class="card hello">
      <view class="n">{{ent.name || '企业工作台'}}</view>
      <view class="s">审核：{{ent.audit_status === 1 ? '已通过' : ent.audit_status === 2 ? '已驳回' : '待审核'}} · 企业导师端</view>
    </view>

    <view class="seg">
      <view class="seg-i {{tab==='dash'?'on':''}}" data-t="dash" bindtap="setTab">概览</view>
      <view class="seg-i {{tab==='pos'?'on':''}}" data-t="pos" bindtap="setTab">岗位</view>
      <view class="seg-i {{tab==='app'?'on':''}}" data-t="app" bindtap="setTab">申请</view>
      <view class="seg-i {{tab==='stu'?'on':''}}" data-t="stu" bindtap="setTab">实习生</view>
      <view class="seg-i {{tab==='ck'?'on':''}}" data-t="ck" bindtap="setTab">打卡</view>
    </view>

    <block wx:if="{{tab==='dash'}}">
      <view class="grid-wrap">
        <view class="metric"><view class="v">{{dash.positionsActive || 0}}<small>/{{dash.positions || 0}}</small></view><view class="l">在架岗位</view></view>
        <view class="metric"><view class="v">{{dash.pendingApplications || 0}}</view><view class="l">待确认</view></view>
        <view class="metric"><view class="v">{{dash.internCount || 0}}</view><view class="l">在册实习</view></view>
        <view class="metric"><view class="v">{{dash.todayCheckins || 0}}</view><view class="l">今日打卡</view></view>
      </view>
      <view wx:if="{{ent.audit_status !== 1}}" class="card" style="background:#FEF9C3">
        <view class="m">企业尚未通过审核，岗位需审核通过后才能上架。</view>
      </view>
    </block>

    <block wx:elif="{{tab==='pos'}}">
      <button class="btn" bindtap="openPosForm">＋ 发布岗位</button>
      <view class="card" wx:for="{{positions}}" wx:key="id">
        <view style="display:flex;justify-content:space-between">
          <view class="m">{{item.title}}</view>
          <text class="tag {{item.stClass}}">{{item.stText}}</text>
        </view>
        <view class="d" style="margin-top:8rpx">{{item.salary || '面议'}}{{item.headcount ? ' · 招'+item.headcount+'人' : ''}}</view>
        <view wx:if="{{item.internTypeText || item.edu_req || item.major_req || item.to_regular}}" class="ptags">
          <text wx:if="{{item.internTypeText}}" class="ptag">{{item.internTypeText}}</text>
          <text wx:if="{{item.edu_req}}" class="ptag">{{item.edu_req}}</text>
          <text wx:if="{{item.major_req}}" class="ptag">{{item.major_req}}</text>
          <text wx:if="{{item.to_regular}}" class="ptag ptag-hot">可转正</text>
        </view>
        <view wx:if="{{item.welfareList.length}}" class="welfare">
          <text wx:for="{{item.welfareList}}" wx:for-item="w" wx:key="*this" class="wchip">{{w}}</text>
        </view>
        <view wx:if="{{item.description}}" class="d" style="margin-top:8rpx">{{item.description}}</view>
      </view>
      <view wx:if="{{!positions.length}}" class="empty"><text class="ei">💼</text>暂无岗位，点击上方发布</view>
    </block>

    <block wx:elif="{{tab==='app'}}">
      <view class="card" wx:for="{{applications}}" wx:key="id">
        <view class="m">{{item.student_name || '学生'}} · {{item.position_title || '岗位'}}</view>
        <view class="d" style="margin-top:8rpx">{{item.student_eeid || ''}} · {{item.apply_time || ''}}</view>
        <view style="margin-top:16rpx">
          <button class="btn btn-sm" data-id="{{item.id}}" data-hired="1" bindtap="confirmHire">录用</button>
          <button class="btn btn-sm btn-r" data-id="{{item.id}}" data-hired="0" bindtap="confirmHire">不录用</button>
        </view>
      </view>
      <view wx:if="{{!applications.length}}" class="empty"><text class="ei">📋</text>暂无待确认申请</view>
    </block>

    <block wx:elif="{{tab==='stu'}}">
      <view class="card" wx:for="{{interns}}" wx:key="id">
        <view class="m">{{item.student_name || '学生'}}</view>
        <view class="d" style="margin-top:8rpx">{{item.student_eeid || ''}} · 指导：{{item.teacher_name || '-'}}</view>
        <view class="d">{{item.position_title || ''}}</view>
      </view>
      <view wx:if="{{!interns.length}}" class="empty"><text class="ei">👨‍🎓</text>暂无在册实习生</view>
    </block>

    <block wx:else>
      <view class="sec-t">今日打卡（只读）</view>
      <view class="card" wx:for="{{checkins}}" wx:key="id">
        <view class="m">{{item.student_name || '学生'}}</view>
        <view class="d" style="margin-top:8rpx">{{item.checkin_time || ''}}{{item.address ? ' · '+item.address : ''}}</view>
        <text class="tag {{item.within_range ? 'tag-g' : 'tag-r'}}">{{item.within_range ? '有效' : '超范围'}}</text>
      </view>
      <view wx:if="{{!checkins.length}}" class="empty"><text class="ei">📍</text>今日暂无打卡记录</view>
    </block>

    <button class="btn btn-o" style="margin-top:32rpx" bindtap="logout">退出登录</button>
  </block>
</view>

<view wx:if="{{showPosForm}}" class="mask" bindtap="closePosForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">发布岗位</view>
    <text class="field-label">岗位名称</text>
    <input class="input" placeholder="如：化工工艺实习生" value="{{posTitle}}" bindinput="onPosTitle" />
    <text class="field-label">岗位描述</text>
    <textarea class="textarea" placeholder="工作内容与要求" value="{{posDesc}}" bindinput="onPosDesc"></textarea>
    <text class="field-label">薪资说明</text>
    <input class="input" placeholder="如：3000元/月" value="{{posSalary}}" bindinput="onPosSalary" />
    <text class="field-label">招聘人数</text>
    <input class="input" type="number" value="{{posHead}}" bindinput="onPosHead" />
    <text class="field-label">实习类型</text>
    <picker class="input picker" mode="selector" range="{{internTypeOpts}}" value="{{posInternTypeIdx}}" bindchange="onPosInternType">{{internTypeOpts[posInternTypeIdx]}}</picker>
    <text class="field-label">学历要求</text>
    <picker class="input picker" mode="selector" range="{{eduOpts}}" value="{{posEduIdx}}" bindchange="onPosEdu">{{eduOpts[posEduIdx]}}</picker>
    <text class="field-label">专业要求</text>
    <input class="input" placeholder="如 计算机类 / 不限" value="{{posMajor}}" bindinput="onPosMajor" />
    <text class="field-label">工作时间</text>
    <input class="input" placeholder="如 周一至周五 9:00-18:00" value="{{posWorkTime}}" bindinput="onPosWorkTime" />
    <text class="field-label">福利待遇（逗号分隔）</text>
    <input class="input" placeholder="如 五险一金,包午餐,交通补贴" value="{{posWelfare}}" bindinput="onPosWelfare" />
    <text class="field-label">报名截止</text>
    <picker class="input picker" mode="date" value="{{posDeadline}}" bindchange="onPosDeadline">{{posDeadline || '点击选择日期'}}</picker>
    <view style="display:flex;justify-content:space-between;align-items:center;margin-top:20rpx">
      <text class="field-label" style="margin:0">提供转正机会</text>
      <switch checked="{{posRegular}}" bindchange="onPosRegular" color="#1677FF" />
    </view>
    <button class="btn" style="margin-top:24rpx" loading="{{submitting}}" bindtap="submitPos">提交审核</button>
    <button class="btn btn-o" bindtap="closePosForm">取消</button>
  </view>
</view>
