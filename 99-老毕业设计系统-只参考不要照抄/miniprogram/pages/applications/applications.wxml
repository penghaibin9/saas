<view class="page">
  <button class="btn" bindtap="toPositions">＋ 浏览岗位并申请</button>

  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:60%"></view><view class="sk sk-line" style="width:40%"></view></view>
    <view class="sk-card"><view class="sk sk-line" style="width:55%"></view><view class="sk sk-line" style="width:35%"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:else class="card" style="margin-top:22rpx">
    <view class="sec-t" style="margin-top:0">我的申请</view>
    <block wx:if="{{list.length}}">
      <view class="appitem" wx:for="{{list}}" wx:key="id">
        <view style="display:flex;justify-content:space-between;align-items:flex-start">
          <view style="flex:1;min-width:0">
            <view class="m">{{item.position_title || '岗位'}}</view>
            <view class="d" style="margin-top:4rpx">{{item.enterprise_name}} · {{item.dateText}}{{item.teacher_name ? (' · 师:' + item.teacher_name) : ''}}</view>
          </view>
          <view class="right" style="margin-left:16rpx">
            <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
            <button wx:if="{{item.status === 0}}" class="btn btn-sm btn-r" style="margin:8rpx 0 0" data-id="{{item.id}}" bindtap="withdraw">撤回</button>
          </view>
        </view>
        <view class="steps">
          <view wx:for="{{item.steps}}" wx:for-item="s" wx:for-index="si" wx:key="label" class="step s-{{s.state}}">
            <view class="step-dot">{{s.mark}}</view>
            <text class="step-label">{{s.label}}</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">📋</text>还没有实习申请</view>
  </view>
</view>
