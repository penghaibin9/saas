<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="metric-grid" style="margin-bottom:20rpx">
      <view class="metric-cell" bindtap="goStudents" hover-class="tap-active">
        <view class="v">{{students.length}}</view>
        <view class="l">本班学生</view>
        <view class="go">查看 ›</view>
      </view>
      <view class="metric-cell {{noCheckin.length ? 'hot' : 'zero'}}" bindtap="goCheckinUrge" hover-class="tap-active">
        <text class="ic">📍</text>
        <view class="v">{{noCheckin.length}}</view>
        <view class="l">未打卡</view>
        <view class="go">{{noCheckin.length ? '去催办 ›' : '查看'}}</view>
      </view>
      <view class="metric-cell {{noWeekly.length ? 'hot' : 'zero'}}" bindtap="goCheckinUrge" hover-class="tap-active">
        <text class="ic">📝</text>
        <view class="v">{{noWeekly.length}}</view>
        <view class="l">缺周报</view>
        <view class="go">{{noWeekly.length ? '去催办 ›' : '查看'}}</view>
      </view>
    </view>
    <button class="btn btn-o" bindtap="goUrge">打开催办中心 →</button>
    <view class="card">
      <view class="sec-t" style="margin-top:0">本班学生<text class="sec-d" bindtap="goStudents">全部 ›</text></view>
      <block wx:if="{{students.length}}">
        <view class="row row-tap" wx:for="{{students}}" wx:key="id" bindtap="goStudents" hover-class="tap-active">
          <view class="m">{{item.real_name}}</view>
          <text class="d">{{item.eeid || ''}} ›</text>
        </view>
      </block>
      <view wx:else class="empty" style="padding:30rpx">未绑定班主任班级</view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">待跟进 · 家长知情<text class="sec-d" bindtap="goParentConsent">审核页 ›</text></view>
      <block wx:if="{{noConsent.length}}">
        <view class="row row-tap" wx:for="{{noConsent}}" wx:key="student_id" bindtap="goParentConsent" hover-class="tap-active">
          <view class="m">{{item.student_name || item.real_name}}</view>
          <text class="tag tag-y">未提交 ›</text>
        </view>
      </block>
      <view wx:else class="empty" style="padding:30rpx">全部已提交</view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">待跟进 · 鉴定表<text class="sec-d" bindtap="goAppraisal">审核页 ›</text></view>
      <block wx:if="{{noAppraisal.length}}">
        <view class="row row-tap" wx:for="{{noAppraisal}}" wx:key="student_id" bindtap="goAppraisal" hover-class="tap-active">
          <view class="m">{{item.student_name || item.real_name}}</view>
          <text class="tag tag-y">未提交 ›</text>
        </view>
      </block>
      <view wx:else class="empty" style="padding:30rpx">全部已提交</view>
    </view>
    <view wx:if="{{noCheckin.length}}" class="card">
      <button class="btn btn-sm" data-kind="noCheckin" bindtap="urge">催办本班未打卡（{{noCheckin.length}}）</button>
    </view>
  </block>
</view>
