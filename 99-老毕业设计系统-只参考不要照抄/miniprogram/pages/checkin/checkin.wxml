<view class="page">
  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:60%"></view></view>
    <view class="sk-card"><view class="sk sk-line" style="width:40%;height:200rpx"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <!-- 实时时钟 -->
    <view class="clock-card">
      <view class="clock-time">{{clockTime}}</view>
      <view class="clock-date">{{clockDate}}</view>
    </view>

    <map wx:if="{{hasGeo}}" class="cmap" latitude="{{mapLat}}" longitude="{{mapLng}}" scale="16"
      markers="{{markers}}" circles="{{circles}}" show-location></map>
    <view wx:else class="map-fallback">📍 实习单位未设置坐标，无法显示地图</view>

    <view class="card" style="text-align:center">
      <block wx:if="{{mine.doubleSlot}}">
        <view style="display:flex;gap:24rpx;justify-content:center">
          <view class="punch {{mine.checkedAm ? 'done' : ''}}" style="width:200rpx;height:200rpx" data-slot="am" bindtap="gpsCheckin">
            <view class="big">上班</view>
            <view class="sm">{{mine.checkedAm ? '✓ 已打卡' : '点击签到'}}</view>
          </view>
          <view class="punch {{mine.checkedPm ? 'done' : ''}}" style="width:200rpx;height:200rpx" data-slot="pm" bindtap="gpsCheckin">
            <view class="big">下班</view>
            <view class="sm">{{mine.checkedPm ? '✓ 已打卡' : '点击签到'}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="punch {{mine.checkedToday ? 'done' : ''}}" bindtap="gpsCheckin">
        <view class="big">{{mine.checkedToday ? '今日已打卡' : 'GPS 打卡'}}</view>
        <view class="sm">{{mine.checkedToday ? '✓ 今日已完成' : '点击定位签到'}}</view>
      </view>

      <view class="dist {{distOk ? 'ok' : 'no'}}" wx:if="{{distText}}">{{distText}}</view>
      <view class="meta">实习单位：{{mine.enterprise || '未分配'}}</view>
      <view class="meta">有效范围：{{mine.checkinRadius ? (mine.checkinRadius + ' 米') : '不限'}}</view>
      <view wx:if="{{hasGeo && mine.checkinRadius && !mine.checkedToday}}" class="fence-hint">📌 打卡时将校验是否在 {{mine.checkinRadius}} 米有效范围内</view>

      <block wx:if="{{!mine.checkedToday}}">
        <image wx:if="{{photoPath}}" src="{{photoPath}}" mode="aspectFill" style="width:200rpx;height:200rpx;border-radius:16rpx;margin-top:24rpx"></image>
        <button class="btn btn-o" style="margin-top:16rpx" bindtap="choosePhoto">📷 {{photoPath ? '重新拍摄' : '拍摄打卡照片（防代打卡）'}}</button>
      </block>
      <button wx:if="{{demoMode && !mine.checkedToday && mine.hasAssignment}}" class="btn btn-o" style="margin-top:16rpx" bindtap="simCheckin">📌 模拟在岗定位打卡（演示模式）</button>
    </view>

    <!-- 打卡统计 -->
    <view class="stat-strip">
      <view class="stat-i"><view class="v c-b">{{monthCount}}</view><view class="l">本月打卡(天)</view></view>
      <view class="stat-i"><view class="v c-g">{{streak}}</view><view class="l">连续打卡(天)</view></view>
      <view class="stat-i"><view class="v">{{mine.total || 0}}</view><view class="l">累计(次)</view></view>
    </view>

    <!-- 本月打卡日历 -->
    <view class="card">
      <view class="cal-head">
        <view class="cm">{{calTitle}}</view>
        <view class="cal-legend">
          <text><text class="dot" style="background:#DCFCE7"></text>已打卡</text>
          <text><text class="dot" style="background:#FEF2F2"></text>缺卡</text>
        </view>
      </view>
      <view class="cal-grid">
        <view class="cal-cell cal-wk" wx:for="{{weekNames}}" wx:key="*this">{{item}}</view>
        <view class="cal-cell" wx:for="{{calCells}}" wx:key="index">
          <view class="cal-day {{item.cls}}">{{item.t}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="sec-t" style="margin-top:0">最近打卡</view>
      <block wx:if="{{records.length}}">
        <view class="row" wx:for="{{records}}" wx:key="id">
          <view>
            <view class="m">{{item.enterprise_name}}</view>
            <view class="d">{{item.timeText}}{{item.address ? (' · ' + item.address) : ''}}</view>
          </view>
          <view style="text-align:right">
            <text class="tag {{item.within_range ? 'tag-g' : 'tag-r'}}">{{item.within_range ? '有效' : ((item.distance != null ? item.distance + '米·' : '') + '超范围')}}</text>
            <image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" data-url="{{item.photo}}" bindtap="previewPhoto" style="display:block;width:96rpx;height:96rpx;border-radius:12rpx;margin-top:8rpx"></image>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">📍</text>暂无打卡记录</view>
    </view>
  </block>
</view>
