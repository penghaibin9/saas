.cmap { width: 100%; height: 360rpx; border-radius: 24rpx; margin-bottom: 22rpx; }
.map-fallback {
  height: 300rpx; border-radius: 24rpx; background: #EEF2F6;
  display: flex; align-items: center; justify-content: center;
  color: #9AA7B8; font-size: 26rpx; margin-bottom: 22rpx;
}
.punch {
  width: 320rpx; height: 320rpx; border-radius: 50%;
  margin: 24rpx auto; background: linear-gradient(145deg, #1677FF, #13C2C2);
  color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(22, 119, 255, 0.35);
}
.punch.done { background: linear-gradient(145deg, #52C41A, #13C2C2); box-shadow: 0 16rpx 48rpx rgba(82, 196, 26, 0.3); }
.punch .big { font-size: 40rpx; font-weight: 700; }
.punch .sm { font-size: 24rpx; opacity: .9; margin-top: 8rpx; }
.dist { font-size: 26rpx; margin-top: 6rpx; font-weight: 700; }
.dist.ok { color: #16A34A; }
.dist.no { color: #DC2626; }
.meta { font-size: 24rpx; color: #9AA7B8; margin-top: 6rpx; }
.fence-hint { font-size: 24rpx; color: #0284C7; background: #E0F2FE; border-radius: 12rpx; padding: 16rpx 20rpx; margin-top: 16rpx; text-align: left; }

/* 实时时钟（商业打卡软件式） */
.clock-card {
  background: linear-gradient(135deg, #0F2456, #1B4B8F);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 22rpx;
  color: #fff;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.clock-time { font-size: 56rpx; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 2rpx; }
.clock-date { font-size: 24rpx; opacity: .85; }
