<view class="page">
  <view class="hero" style="margin:0 -24rpx 24rpx;border-radius:0 0 40rpx 40rpx;padding:48rpx 32rpx">
    <view class="n">{{user.realName || '用户'}}</view>
    <view class="s">{{user.roleName || (isTeacher ? '指导教师' : '学生')}} · {{user.username}}</view>
  </view>

  <view class="cell-group">
    <view class="cell-group-hd">账号</view>
    <view class="cell" data-url="/pages/profile/profile" bindtap="nav">
      <view class="cell-ic ic-b">👤</view>
      <view class="cell-body">个人资料</view>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" data-url="/pages/profile/profile" bindtap="nav">
      <view class="cell-ic ic-y">🔑</view>
      <view class="cell-body">修改密码</view>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <block wx:if="{{!isTeacher}}">
    <view class="cell-group">
      <view class="cell-group-hd">实习监管 · 高频</view>
      <view class="cell" data-url="/pages/parentconsent/parentconsent" bindtap="nav">
        <view class="cell-ic ic-b">👪</view><view class="cell-body">家长知情书</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/appraisal/appraisal" bindtap="nav">
        <view class="cell-ic ic-g">📋</view><view class="cell-body">实习鉴定表</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/internscore/internscore" bindtap="nav">
        <view class="cell-ic ic-t">📊</view><view class="cell-body">实习考评</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/agreement/agreement" bindtap="nav">
        <view class="cell-ic ic-r">📑</view><view class="cell-body">实习协议</view><text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="cell-group">
      <view class="cell-group-hd">毕业设计</view>
      <view class="cell" data-url="/pages/taskbook/taskbook" bindtap="nav">
        <view class="cell-ic ic-b">📋</view><view class="cell-body">毕设任务书</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/topicround/topicround" bindtap="nav">
        <view class="cell-ic ic-t">🔄</view><view class="cell-body">选题互选</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/plagiarism/plagiarism" bindtap="nav">
        <view class="cell-ic ic-y">🔍</view><view class="cell-body">查重检测</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/grade/grade" bindtap="nav">
        <view class="cell-ic ic-o">🏅</view><view class="cell-body">毕设成绩</view><text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="cell-group">
      <view class="cell-group-hd">更多</view>
      <view class="cell" data-url="/pages/assignment/assignment" bindtap="nav">
        <view class="cell-ic ic-p">🏢</view><view class="cell-body">我的实习</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/employment/employment" bindtap="nav">
        <view class="cell-ic ic-p">💼</view><view class="cell-body">就业去向</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/notifications/notifications" bindtap="nav">
        <view class="cell-ic ic-y">🔔</view><view class="cell-body">通知中心</view><text class="cell-arrow">›</text>
      </view>
    </view>
  </block>

  <block wx:if="{{isTeacher}}">
    <view class="cell-group">
      <view class="cell-group-hd">教师工作台</view>
      <view class="cell" data-url="/pages/urgehub/urgehub" bindtap="nav">
        <view class="cell-ic ic-y">📣</view><view class="cell-body">催办中心</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/classteacher/classteacher" bindtap="nav">
        <view class="cell-ic ic-o">👩‍🏫</view><view class="cell-body">班级工作台</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/teachervisit/teachervisit" bindtap="nav">
        <view class="cell-ic ic-t">🚗</view><view class="cell-body">教师巡访</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/internscore/internscore" bindtap="nav">
        <view class="cell-ic ic-t">📊</view><view class="cell-body">考评发布</view><text class="cell-arrow">›</text>
      </view>
    </view>
    <view class="cell-group">
      <view class="cell-group-hd">审核事项</view>
      <view class="cell" data-url="/pages/parentconsent/parentconsent" bindtap="nav">
        <view class="cell-ic ic-b">👪</view><view class="cell-body">家长知情审核</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/appraisal/appraisal" bindtap="nav">
        <view class="cell-ic ic-g">📋</view><view class="cell-body">鉴定表审核</view><text class="cell-arrow">›</text>
      </view>
      <view class="cell" data-url="/pages/risk/risk" bindtap="nav">
        <view class="cell-ic ic-r">⚠️</view><view class="cell-body">风险预警</view><text class="cell-arrow">›</text>
      </view>
    </view>
  </block>

  <view class="cell-group">
    <view class="cell-group-hd">系统</view>
    <view class="cell" data-url="/pages/announcements/announcements" bindtap="nav">
      <view class="cell-ic ic-b">📢</view><view class="cell-body">公示公告</view><text class="cell-arrow">›</text>
    </view>
  </view>

  <button class="btn btn-r" style="margin-top:32rpx" bindtap="logout">退出登录</button>
  <view class="footer-ver">实习管理平台 · v1.4</view>
</view>
