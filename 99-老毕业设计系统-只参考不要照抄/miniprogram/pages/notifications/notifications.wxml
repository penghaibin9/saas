<view class="page">
  <button wx:if="{{list.length}}" class="btn btn-o" bindtap="readAll">全部已读</button>

  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:else class="card" style="margin-top:22rpx">
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" data-read="{{item.is_read}}" bindtap="readOne">
        <view>
          <view class="m">{{item.is_read ? '' : '🔵 '}}{{item.title}}</view>
          <view class="d">{{item.content}}</view>
          <view class="d">{{item.timeText}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">🔔</text>暂无通知</view>
  </view>
</view>
