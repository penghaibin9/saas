<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:elif="{{!a}}" class="empty"><text class="ei">🏢</text>老师尚未为你分配实习</view>

  <block wx:else>
    <view class="card hello">
      <view class="n">{{a.enterprise_name || '实习单位'}}</view>
      <view class="s">指导老师：{{a.teacher_name || '-'}}</view>
    </view>
    <view class="card">
      <view class="kv"><text class="k">实习计划</text><text>{{a.plan_title || '-'}}</text></view>
      <view class="kv"><text class="k">指导教师</text><text>{{a.teacher_name || '-'}}</text></view>
      <view class="kv"><text class="k">实习企业</text><text>{{a.enterprise_name || '-'}}</text></view>
      <view wx:if="{{a.checkin_radius != null}}" class="kv"><text class="k">打卡范围</text><text>{{a.checkin_radius}} 米</text></view>
    </view>
    <button class="btn" bindtap="toCheckin">去打卡 →</button>
    <view class="acts">
      <button class="btn btn-o" bindtap="toTransfer">申请换岗</button>
      <button class="btn btn-o" bindtap="toTerminate">终止实习</button>
      <button class="btn btn-o" bindtap="completeIntern">实习期满结束</button>
    </view>
  </block>
</view>
