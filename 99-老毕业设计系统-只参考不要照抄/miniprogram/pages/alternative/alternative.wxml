<view class="page">
  <view class="card">
    <view class="sec-t" style="margin-top:0">申请免实习/其他去向</view>
    <text class="field-label">类型</text>
    <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIdx}}" bindchange="onType">
      <view class="input">{{types[typeIdx].label}}</view>
    </picker>
    <text class="field-label">原因说明</text>
    <textarea class="textarea" value="{{reason}}" bindinput="onReason" placeholder="请详细说明" />
    <button class="btn btn-o" bindtap="chooseFile">{{fFile ? fFile.name : '上传证明材料（可选）'}}</button>
    <button class="btn" loading="{{submitting}}" bindtap="submit">提交申请</button>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <view wx:else class="card">
    <view class="sec-t" style="margin-top:0">申请记录</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id">
        <view>
          <view class="m">{{item.typeLabel}}</view>
          <view class="d">{{item.dateText}} · {{item.reason}}</view>
        </view>
        <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </block>
    <view wx:else class="empty">暂无申请</view>
  </view>
</view>
