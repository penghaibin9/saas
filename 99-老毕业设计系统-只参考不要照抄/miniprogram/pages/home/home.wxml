<view class="page">
  <block wx:if="{{loading}}">
    <view class="hero sk-card" style="margin:0 -24rpx;border-radius:0 0 40rpx 40rpx;height:200rpx"></view>
    <view class="sk-card"><view class="sk sk-line" style="width:80%"></view></view>
    <view class="sk-card"><view class="sk sk-line" style="width:55%"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <!-- ========== 学生首页 ========== -->
  <block wx:elif="{{!isTeacher}}">
    <view class="hero">
      <view class="hero-top">
        <view>
          <view class="n">{{user.realName || '同学'}}，你好</view>
          <view class="s">{{assignment ? assignment.enterprise_name : '尚未分配实习单位'}}</view>
          <view class="hero-tag">{{graduationYear}}届 · 岗位实习</view>
        </view>
        <view class="bell-wrap" bindtap="toNotifications">
          <text class="bell-ic">🔔</text>
          <text wx:if="{{unread}}" class="bell-nb">{{unread > 99 ? '99+' : unread}}</text>
        </view>
      </view>
    </view>

    <!-- 高频快捷入口 -->
    <view class="quick-row">
      <view class="quick-item" wx:for="{{stuQuick}}" wx:key="label" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="go" hover-class="tap-active">
        <view class="quick-ic {{item.cls}}">{{item.icon}}</view>
        <text class="quick-tl">{{item.label}}</text>
      </view>
    </view>

    <!-- 待办提醒（优先级最高） -->
    <view wx:if="{{todoItems.length}}" class="todo-list">
      <view class="sec-t" style="margin-top:0">待办提醒<text class="sec-d">{{todoItems.length}} 项</text></view>
      <view wx:for="{{todoItems}}" wx:key="title" class="todo-item {{item.cls}}" data-key="{{item.key}}" data-section="{{item.section}}" bindtap="goAlert" hover-class="tap-active">
        <text class="todo-ic">{{item.icon}}</text>
        <view class="todo-body">
          <view class="todo-title">{{item.title}}</view>
          <view class="todo-desc">{{item.desc}}</view>
        </view>
        <text class="todo-arrow">›</text>
      </view>
    </view>

    <!-- 全流程监管进度 -->
    <view wx:if="{{flowSteps.length}}" class="card">
      <view class="card-hd">
        <view>
          <view class="title">全流程监管</view>
          <view class="sub">实习全流程线上闭环</view>
        </view>
        <text class="more" bindtap="goFlowDetail">继续办理 ›</text>
      </view>
      <view class="flow-summary">
        <view>
          <view class="pct">{{flowPct}}%</view>
          <view class="txt">已完成 {{flowDone}}/{{flowSteps.length}} 项</view>
        </view>
        <view class="tag tag-b">过程闭环</view>
      </view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="flow-scroll">
        <view class="flow-track">
          <view wx:for="{{flowSteps}}" wx:key="key" class="flow-node {{item.done ? 'done' : item.pending ? 'active' : ''}}" data-url="{{item.url}}" bindtap="goFlowStep" hover-class="tap-active">
            <view class="flow-circle">{{item.done ? '✓' : item.pending ? '!' : index + 1}}</view>
            <text class="flow-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 实习进度（可点击） -->
    <view class="sec-t">实习进度<text class="sec-d">点击查看</text></view>
    <view class="card prog-card">
      <view class="prog-row prog-row-tap" data-kind="checkin" bindtap="goProg">
        <text class="pl">签到</text>
        <view class="prog-bar"><view class="prog-fill" style="width:{{progCheckin}}%"></view></view>
        <text class="pv">{{progress.checkinCount || 0}}/{{progress.reqCheckin || 0}} ›</text>
      </view>
      <view class="prog-row prog-row-tap" data-kind="logs" bindtap="goProg">
        <text class="pl">周报</text>
        <view class="prog-bar"><view class="prog-fill" style="width:{{progWeekly}}%"></view></view>
        <text class="pv">{{progress.weeklyCount || 0}}/{{progress.reqWeekly || 0}} ›</text>
      </view>
      <view class="prog-row prog-row-tap" data-kind="logs" bindtap="goProg">
        <text class="pl">月报</text>
        <view class="prog-bar"><view class="prog-fill" style="width:{{progMonthly}}%"></view></view>
        <text class="pv">{{progress.monthlyCount || 0}}/{{progress.reqMonthly || 0}} ›</text>
      </view>
    </view>

    <!-- 实习单位 -->
    <view wx:if="{{assignment}}" class="card" data-url="/pages/assignment/assignment" bindtap="goNav">
      <view class="ent-card ent-card-tap">
        <view class="ent-ic">{{assignment.enterprise_name ? assignment.enterprise_name[0] : '企'}}</view>
        <view class="ent-info">
          <view class="name">{{assignment.enterprise_name || '-'}}</view>
          <view class="meta">指导教师 · {{assignment.teacher_name || '-'}}</view>
        </view>
      </view>
    </view>

    <!-- 分组功能 -->
    <block wx:for="{{menuGroups}}" wx:key="title" wx:for-item="group">
      <view class="sec-t">{{group.title}}<text wx:if="{{group.desc}}" class="sec-d">{{group.desc}}</text></view>
      <view class="card menu-group" style="padding:12rpx 8rpx">
        <view class="menu-grid">
          <view class="menu-item" wx:for="{{group.items}}" wx:key="url" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="go" hover-class="tap-active">
            <view class="menu-ic {{item.cls}}">{{item.icon}}</view>
            <text class="menu-tl">{{item.label}}</text>
            <text wx:if="{{item.badge}}" class="menu-nb">{{item.badge}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- ========== 教师首页 ========== -->
  <block wx:else>
    <view class="hero">
      <view class="hero-top">
        <view>
          <view class="n">{{user.realName || '老师'}}，您好</view>
          <view class="s">指导教师 · 本组 {{assignedStudents}} 名学生</view>
          <view class="hero-tag">待办 {{totalPending}} 项</view>
        </view>
        <view class="bell-wrap" bindtap="toNotifications">
          <text class="bell-ic">🔔</text>
          <text wx:if="{{unread}}" class="bell-nb">{{unread > 99 ? '99+' : unread}}</text>
        </view>
      </view>
    </view>

    <view class="quick-row">
      <view class="quick-item" wx:for="{{teaQuick}}" wx:key="label" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="go" hover-class="tap-active">
        <view class="quick-ic {{item.cls}}">{{item.icon}}</view>
        <text class="quick-tl">{{item.label}}</text>
        <text wx:if="{{item.badge}}" class="menu-nb" style="position:relative;top:-60rpx;right:-30rpx">{{item.badge}}</text>
      </view>
    </view>

    <view class="cta-row">
      <view class="cta-primary" data-url="/pages/review/review" bindtap="go" hover-class="tap-active">
        <view class="t">待批阅中心</view>
        <view class="d">{{totalPending}} 项待处理</view>
      </view>
      <view class="cta-secondary" data-url="/pages/urgehub/urgehub" bindtap="goNav" hover-class="tap-active">
        <view class="t">催办中心</view>
        <view class="d">一键发送提醒</view>
      </view>
    </view>

    <view wx:if="{{benchmarkPending.parentConsentPending || benchmarkPending.appraisalPending || benchmarkPending.taskBookMissing}}" class="card">
      <view class="card-hd"><view class="title">监管待办</view></view>
      <view wx:if="{{benchmarkPending.taskBookMissing}}" class="row row-tap" data-key="taskbook" bindtap="goAlert" hover-class="tap-active">
        <text class="m">📋 未下达任务书</text><text class="tag tag-y">{{benchmarkPending.taskBookMissing}} 人 ›</text>
      </view>
      <view wx:if="{{benchmarkPending.parentConsentPending}}" class="row row-tap" data-key="parentconsent" bindtap="goAlert" hover-class="tap-active">
        <text class="m">👪 家长知情待审</text><text class="tag tag-y">{{benchmarkPending.parentConsentPending}} 份 ›</text>
      </view>
      <view wx:if="{{benchmarkPending.appraisalPending}}" class="row row-tap" data-key="appraisal" bindtap="goAlert" hover-class="tap-active">
        <text class="m">📋 鉴定表待审</text><text class="tag tag-y">{{benchmarkPending.appraisalPending}} 份 ›</text>
      </view>
    </view>

    <view wx:for="{{flowAlerts}}" wx:key="title" class="todo-item info" data-key="{{item.key}}" data-section="{{item.section}}" bindtap="goAlert" hover-class="tap-active">
      <text class="todo-ic">{{item.icon || '📌'}}</text>
      <view class="todo-body"><view class="todo-title">{{item.title}}</view><view class="todo-desc">{{item.desc}}</view></view>
      <text class="todo-arrow">›</text>
    </view>

    <view wx:if="{{riskBadge}}" class="todo-item err" data-url="/pages/risk/risk" bindtap="goNav">
      <text class="todo-ic">⚠️</text>
      <view class="todo-body">
        <view class="todo-title">实习风险预警</view>
        <view class="todo-desc">高危 {{risk.high || 0}} · 提醒 {{risk.medium || 0}} 人</view>
      </view>
      <text class="todo-arrow">›</text>
    </view>

    <view class="sec-t">批阅概览<text class="sec-d">点击进入</text></view>
    <view class="metric-grid">
      <view
        class="metric-cell {{item.hot ? 'hot' : ''}} {{item.zero ? 'zero' : ''}}"
        wx:for="{{metricCells}}"
        wx:key="l"
        data-url="{{item.url}}"
        data-section="{{item.section}}"
        data-istab="{{item.tab ? 1 : 0}}"
        data-v="{{item.v}}"
        data-l="{{item.l}}"
        bindtap="goMetric"
        hover-class="tap-active"
      >
        <text class="ic">{{item.icon}}</text>
        <view class="v">{{item.v}}</view>
        <view class="l">{{item.l}}</view>
        <view class="go">{{item.goText}}</view>
      </view>
    </view>

    <block wx:for="{{menuGroups}}" wx:key="title" wx:for-item="group">
      <view class="sec-t">{{group.title}}</view>
      <view class="card menu-group" style="padding:12rpx 8rpx">
        <view class="menu-grid">
          <view class="menu-item" wx:for="{{group.items}}" wx:key="url" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="go" hover-class="tap-active">
            <view class="menu-ic {{item.cls}}">{{item.icon}}</view>
            <text class="menu-tl">{{item.label}}</text>
            <text wx:if="{{item.badge}}" class="menu-nb">{{item.badge}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
