<view class="page">
  <view class="card" style="background:#F0F9FF;border:1rpx solid #BAE6FD">
    <view class="m" style="font-size:26rpx;color:#0369A1">论文原创性与 AIGC 检测，结果仅供参考，以学校最终认定为准。</view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <view wx:else class="card">
    <view class="sec-t" style="margin-top:0">成果查重</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id">
        <view>
          <view class="m">{{item.title}}</view>
          <view class="d">{{item.docLabel}} · {{item.dateText}}</view>
        </view>
        <view class="right">
          <text class="tag {{item.rateClass}}">{{item.rateText}}</text>
          <button class="btn btn-sm" data-id="{{item.id}}" bindtap="runCheck">检测</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty">
      <text class="ei">🔍</text>请先在「我的成果」上传论文文档
      <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="goAchievements">去上传成果 →</button>
    </view>
  </view>
</view>
