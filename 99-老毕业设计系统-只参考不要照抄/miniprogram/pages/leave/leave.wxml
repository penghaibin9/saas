<view class="page">
  <button class="btn" bindtap="openForm">＋ 申请请假</button>

  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:70%"></view><view class="sk sk-line" style="width:40%"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:else class="card" style="margin-top:22rpx">
    <view class="sec-t" style="margin-top:0">请假记录</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="openDetail">
        <view>
          <view class="m">{{item.startText}} ~ {{item.endText}}（{{item.days}}天）</view>
          <view class="d">{{item.reason}}{{item.reject_reason ? (' · 驳回：' + item.reject_reason) : ''}}</view>
        </view>
        <view class="right"><text class="tag {{item.statusClass}}">{{item.statusText}}</text> <text style="color:#9AA7B8"> ›</text></view>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">🏖️</text>暂无请假记录</view>
  </view>
</view>

<!-- 申请表单 -->
<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">请假申请</view>
    <text class="field-label">开始日期</text>
    <picker mode="date" value="{{fStart}}" bindchange="onStart">
      <view class="input">{{fStart || '请选择开始日期'}}</view>
    </picker>
    <text class="field-label">结束日期</text>
    <picker mode="date" value="{{fEnd}}" bindchange="onEnd">
      <view class="input">{{fEnd || '请选择结束日期'}}</view>
    </picker>
    <view wx:if="{{fDays}}" class="banner banner-ok" style="margin-top:16rpx">
      <text class="bi">🗓️</text>
      <view class="bx">共请假 {{fDays}} 天</view>
    </view>
    <text class="field-label">请假事由</text>
    <textarea class="textarea" placeholder="请说明请假原因" value="{{fReason}}" bindinput="onReason" auto-height />
    <view class="fld-err">{{fErr}}</view>
    <button class="btn" loading="{{saving}}" bindtap="submitForm">提交</button>
    <button class="btn btn-o" bindtap="closeForm">取消</button>
  </view>
</view>

<!-- 详情 -->
<view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">请假详情</view>
    <view class="kv"><text class="k">起止</text><text>{{detail.startText}} ~ {{detail.endText}}</text></view>
    <view class="kv"><text class="k">天数</text><text>{{detail.days}} 天</text></view>
    <view class="kv"><text class="k">状态</text><text>{{detail.statusText}}</text></view>
    <view wx:if="{{detail.reject_reason}}" class="kv"><text class="k">驳回原因</text><text style="color:#DC2626">{{detail.reject_reason}}</text></view>
    <view class="detail-body">{{detail.reason || '（无）'}}</view>
    <block wx:if="{{detail.status === 0}}">
      <button class="btn" bindtap="submitDraft">提交审批</button>
      <button class="btn btn-r" bindtap="removeDraft">删除</button>
    </block>
    <button wx:elif="{{detail.status === 3}}" class="btn" bindtap="submitDraft">重新提交</button>
    <button class="btn btn-o" bindtap="closeDetail">关闭</button>
  </view>
</view>
