<view class="page">
  <button class="btn" bindtap="openForm">＋ 上传毕业设计成果</button>

  <block wx:if="{{loading}}">
    <view class="sk-card"><view class="sk sk-line" style="width:70%"></view><view class="sk sk-line" style="width:40%"></view></view>
  </block>

  <view wx:elif="{{err}}" class="retry">
    <view class="ei">⚠️</view>{{err}}
    <button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button>
  </view>

  <view wx:else class="card" style="margin-top:22rpx">
    <view class="sec-t" style="margin-top:0">我的成果</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="openDetail">
        <view>
          <view class="m">{{item.title}}</view>
          <view class="d">{{item.docLabel}} · {{item.dateText}}{{item.reject_reason ? (' · 驳回：' + item.reject_reason) : ''}}</view>
        </view>
        <view class="right"><text class="tag {{item.statusClass}}">{{item.statusText}}</text> <text style="color:#9AA7B8"> ›</text></view>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">🎓</text>暂无成果，点上方按钮上传</view>
  </view>
</view>

<!-- 上传/重新提交 -->
<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{editId ? '重新提交成果' : '上传毕业设计成果'}}</view>
    <text class="field-label">文档类型</text>
    <picker mode="selector" range="{{docTypes}}" range-key="label" value="{{docIdx}}" bindchange="onDocType">
      <view class="input">{{docTypes[docIdx].label}}</view>
    </picker>
    <text class="field-label">成果标题</text>
    <input class="input" placeholder="如：XX系统设计与实现" value="{{fTitle}}" bindinput="onTitle" />
    <text class="field-label">成果链接</text>
    <input class="input" placeholder="http:// 或文档链接" value="{{fLink}}" bindinput="onLink" />
    <view class="fld-err">{{fErr}}</view>
    <button class="btn" loading="{{saving}}" bindtap="submitForm">提交</button>
    <button class="btn btn-o" bindtap="closeForm">取消</button>
  </view>
</view>

<!-- 详情 -->
<view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">成果详情</view>
    <view class="kv"><text class="k">类型</text><text>{{detail.docLabel || '成果'}}</text></view>
    <view class="kv"><text class="k">标题</text><text>{{detail.title}}</text></view>
    <view class="kv"><text class="k">状态</text><text>{{detail.statusText}}</text></view>
    <view wx:if="{{detail.link}}" class="kv"><text class="k">链接</text><text class="link-a" user-select>{{detail.link}}</text></view>
    <view wx:if="{{detail.reject_reason}}" class="kv"><text class="k">驳回原因</text><text style="color:#DC2626">{{detail.reject_reason}}</text></view>
    <block wx:if="{{detail.status !== 1}}">
      <button class="btn" bindtap="resubmit">编辑并重新提交</button>
      <button class="btn btn-r" bindtap="removeAch">删除</button>
    </block>
    <button class="btn btn-o" bindtap="closeDetail">关闭</button>
  </view>
</view>
