<view class="page">
  <button wx:if="{{isTeacher}}" class="btn" bindtap="openPoolForm">＋ 发布课题到选题池</button>
  <button wx:if="{{!isTeacher && activeRound && activeRound.status === 1}}" class="btn btn-o" bindtap="openForm">提交选题志愿</button>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="card">
      <view class="sec-t" style="margin-top:0">选题轮次</view>
      <block wx:if="{{rounds.length}}">
        <view class="row" wx:for="{{rounds}}" wx:key="id">
          <view>
            <view class="m">{{item.name}}</view>
            <view class="d">{{item.rangeText}} · 最多 {{item.max_choices}} 志愿</view>
          </view>
          <text class="tag {{item.stClass}}">{{item.stText}}</text>
        </view>
      </block>
      <view wx:else class="empty"><text class="ei">🔄</text>暂无选题轮次</view>
    </view>
    <view wx:if="{{!isTeacher && myChoices.length}}" class="card">
      <view class="sec-t" style="margin-top:0">我的志愿{{matched ? '' : ' · 待匹配'}}</view>
      <view wx:if="{{matched}}" class="flow-summary" style="margin-bottom:8rpx">
        <view class="txt">🎉 已为你匹配课题,详见下方"已中选"</view>
        <view class="tag tag-g">已中选</view>
      </view>
      <view class="row" wx:for="{{myChoices}}" wx:key="id">
        <view>
          <view class="m">第{{item.priority}}志愿 · {{item.topic_title || '-'}}</view>
          <view class="d">{{item.teacher_name || ''}}</view>
        </view>
        <text class="tag {{item.cstClass}}">{{item.cstText}}</text>
      </view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">可选课题池</view>
      <block wx:if="{{pool.length}}">
        <view class="row" wx:for="{{pool}}" wx:key="id">
          <view>
            <view class="m">{{item.title}}</view>
            <view class="d">{{item.teacher_name || ''}} · 名额 {{item.quota || 1}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty">课题池为空</view>
    </view>
  </block>
</view>

<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">提交志愿 · {{activeRound.name}}</view>
    <text class="field-label">第一志愿</text>
    <picker mode="selector" range="{{pool}}" range-key="title" data-i="0" bindchange="onPick">
      <view class="input">{{pickLabels[0]}}</view>
    </picker>
    <text class="field-label">第二志愿</text>
    <picker mode="selector" range="{{pool}}" range-key="title" data-i="1" bindchange="onPick">
      <view class="input">{{pickLabels[1]}}</view>
    </picker>
    <text class="field-label">第三志愿</text>
    <picker mode="selector" range="{{pool}}" range-key="title" data-i="2" bindchange="onPick">
      <view class="input">{{pickLabels[2]}}</view>
    </picker>
    <view class="fld-err">{{fErr}}</view>
    <button class="btn" loading="{{saving}}" bindtap="submitChoices">提交</button>
    <button class="btn btn-o" bindtap="closeForm">取消</button>
  </view>
</view>

<view wx:if="{{showPoolForm}}" class="mask" bindtap="closePoolForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">发布毕设课题</view>
    <text class="field-label">课题名称</text>
    <input class="input" value="{{poolTitle}}" bindinput="onPoolTitle" placeholder="课题标题" />
    <text class="field-label">招收名额</text>
    <input class="input" type="number" value="{{poolQuota}}" bindinput="onPoolQuota" />
    <text class="field-label">简介</text>
    <textarea class="textarea" value="{{poolDesc}}" bindinput="onPoolDesc" />
    <button class="btn" loading="{{poolSaving}}" bindtap="publishPool">发布</button>
    <button class="btn btn-o" bindtap="closePoolForm">取消</button>
  </view>
</view>
