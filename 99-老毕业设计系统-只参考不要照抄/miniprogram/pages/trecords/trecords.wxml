<view class="page">
  <button class="btn" bindtap="openForm">＋ 新增工作记录</button>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <view wx:else class="card" style="margin-top:22rpx">
    <view class="sec-t" style="margin-top:0">月报 / 走访记录</view>
    <block wx:if="{{list.length}}">
      <view class="row" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="openDetail">
        <view>
          <view class="m">{{item.typeText}}{{item.title}}</view>
          <view class="d">{{item.dateText}}{{item.student_name ? (' · ' + item.student_name) : ''}}</view>
        </view>
        <view class="right"><text class="tag {{item.statusClass}}">{{item.statusText}}</text> <text style="color:#9AA7B8"> ›</text></view>
      </view>
    </block>
    <view wx:else class="empty"><text class="ei">🗂️</text>暂无工作记录</view>
  </view>
</view>

<view wx:if="{{showForm}}" class="mask" bindtap="closeForm">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">新增工作记录</view>
    <view class="seg">
      <view class="seg-i {{type === 'monthly' ? 'on' : ''}}" data-t="monthly" bindtap="setType">月报</view>
      <view class="seg-i {{type === 'visit' ? 'on' : ''}}" data-t="visit" bindtap="setType">走访</view>
    </view>
    <text class="field-label">关联学生（可选）</text>
    <picker mode="selector" range="{{students}}" range-key="label" value="{{stuIndex}}" bindchange="onStu">
      <view class="input">{{students[stuIndex].label}}</view>
    </picker>
    <text class="field-label">日期</text>
    <picker mode="date" value="{{fDate}}" bindchange="onDate"><view class="input">{{fDate}}</view></picker>
    <text class="field-label">标题</text>
    <input class="input" placeholder="如：3月实习月报" value="{{fTitle}}" bindinput="onTitle" />
    <text class="field-label">内容</text>
    <textarea class="textarea" placeholder="工作小结 / 走访情况…" value="{{fContent}}" bindinput="onContent" auto-height />
    <text class="field-label">附件（可选）</text>
    <view class="input" bindtap="chooseFile">{{fFile ? fFile.name : '点击选择文件'}}</view>
    <view class="fld-err">{{fErr}}</view>
    <button class="btn" loading="{{saving}}" bindtap="submitForm">提交</button>
    <button class="btn btn-o" bindtap="closeForm">取消</button>
  </view>
</view>

<view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{detail.typeText}}{{detail.title}}</view>
    <view class="kv"><text class="k">日期</text><text>{{detail.dateText}}</text></view>
    <view wx:if="{{detail.student_name}}" class="kv"><text class="k">学生</text><text>{{detail.student_name}}</text></view>
    <view class="detail-body">{{detail.content || '（无内容）'}}</view>
    <button class="btn btn-r" bindtap="removeItem">删除</button>
    <button class="btn btn-o" bindtap="closeDetail">关闭</button>
  </view>
</view>
