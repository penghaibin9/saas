.page { padding: 24rpx; }
.loading, .empty { text-align: center; color: #94A3B8; padding: 60rpx 0; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(15,36,86,.06); }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.field { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; color: #64748B; margin-bottom: 8rpx; }
.picker, textarea { background: #F8FAFC; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
textarea { min-height: 160rpx; }
.btn { margin-top: 16rpx; background: #0EA5E9; color: #fff; border-radius: 12rpx; }
.sec { font-size: 28rpx; color: #64748B; margin: 16rpx 0 12rpx; }
.item .row { display: flex; justify-content: space-between; font-weight: 600; }
.item .st { font-size: 24rpx; color: #0EA5E9; font-weight: 400; }
.item .sub { font-size: 24rpx; color: #64748B; margin-top: 8rpx; }
