.stu-page { padding-top: 0; }

.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 16rpx 0 20rpx;
  background: var(--bg, #F5F7FA);
}

.search-inner {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 36, 86, 0.06);
  border: 1rpx solid #E5E7EB;
}

.search-ic { font-size: 28rpx; margin-right: 12rpx; opacity: .55; }

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.search-clear {
  font-size: 40rpx;
  color: var(--t3, #9CA3AF);
  padding: 0 8rpx;
  line-height: 1;
}

.stu-hd {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--t3, #6B7280);
}

.stu-count { font-weight: 600; color: var(--t1, #111827); font-size: 26rpx; }
.stu-kw { color: var(--blue, #1677FF); }
.stu-shown { margin-left: auto; }

.stu-row { flex-direction: column; align-items: stretch !important; }
.stu-row .stu-main { width: 100%; }
.stu-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--t3, #9AA7B8);
}
.stu-act { color: var(--blue, #1677FF); font-size: 22rpx; }

.stu-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--t3, #9CA3AF);
}
.stu-more.muted { opacity: .85; }

.stu-line { display: flex; align-items: center; gap: 18rpx; width: 100%; }
.stu-line .stu-main { flex: 1; min-width: 0; }
