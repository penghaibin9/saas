<view class="page">
  <view class="card" style="background:#F0F9FF;border:1rpx solid #BAE6FD">
    <view class="m" style="font-size:26rpx;color:#0369A1">对未完成事项的学生一键发送提醒，提升过程材料完成率。</view>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{err}}" class="retry"><view class="ei">⚠️</view>{{err}}<button class="btn btn-o" style="width:auto;display:inline-block;margin-top:24rpx" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="card">
      <view class="sec-t" style="margin-top:0">未打卡（{{noCheckin.length}}）</view>
      <block wx:if="{{noCheckin.length}}">
        <view class="row" wx:for="{{noCheckin}}" wx:key="student_id">
          <view><view class="m">{{item.student_name}}</view><view class="d">{{item.enterprise_name || ''}}</view></view>
        </view>
        <button class="btn btn-sm" data-kind="noCheckin" loading="{{urging}}" bindtap="urge">催办未打卡</button>
      </block>
      <view wx:else class="empty" style="padding:30rpx">暂无</view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">周报未达标（{{noWeekly.length}}）</view>
      <block wx:if="{{noWeekly.length}}">
        <view class="row" wx:for="{{noWeekly}}" wx:key="student_id"><view class="m">{{item.student_name}}</view></view>
        <button class="btn btn-sm" data-kind="noWeekly" loading="{{urging}}" bindtap="urge">催办周报</button>
      </block>
      <view wx:else class="empty" style="padding:30rpx">暂无</view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">未交家长知情（{{noConsent.length}}）</view>
      <block wx:if="{{noConsent.length}}">
        <view class="row" wx:for="{{noConsent}}" wx:key="student_id"><view class="m">{{item.student_name}}</view></view>
        <button class="btn btn-sm" data-kind="noConsent" loading="{{urging}}" bindtap="urge">催办家长知情</button>
      </block>
      <view wx:else class="empty" style="padding:30rpx">暂无</view>
    </view>
    <view class="card">
      <view class="sec-t" style="margin-top:0">未交鉴定表（{{noAppraisal.length}}）</view>
      <block wx:if="{{noAppraisal.length}}">
        <view class="row" wx:for="{{noAppraisal}}" wx:key="student_id"><view class="m">{{item.student_name}}</view></view>
        <button class="btn btn-sm" data-kind="noAppraisal" loading="{{urging}}" bindtap="urge">催办鉴定表</button>
      </block>
      <view wx:else class="empty" style="padding:30rpx">暂无</view>
    </view>
  </block>
</view>
