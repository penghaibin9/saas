page {
  --blue: #1677FF;
  --blue-light: #E6F4FF;
  --teal: #13C2C2;
  --orange: #FA8C16;
  --green: #52C41A;
  --red: #FF4D4F;
  --purple: #722ED1;
  --brand: #0F2456;
  --brand-mid: #1B3A7A;
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --border: #EEF0F4;
  --shadow: 0 4rpx 24rpx rgba(15, 36, 86, 0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(15, 36, 86, 0.1);
  --t1: #1F2937;
  --t2: #6B7280;
  --t3: #9CA3AF;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Noto Sans SC", sans-serif;
  color: var(--t1);
  font-size: 28rpx;
  line-height: 1.5;
}

.page { padding: 0 24rpx 160rpx; box-sizing: border-box; min-height: 100vh; }

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.card-flat { box-shadow: none; border: 1rpx solid var(--border); }

.card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-hd .title { font-size: 30rpx; font-weight: 600; color: var(--t1); }
.card-hd .sub { font-size: 22rpx; color: var(--t3); margin-top: 4rpx; }
.card-hd .more { font-size: 24rpx; color: var(--blue); }

.sec-t {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t1);
  margin: 28rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.sec-t::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--blue), var(--teal));
}
.sec-d { font-size: 22rpx; color: var(--t3); font-weight: 400; margin-left: 8rpx; }

/* Hero */
.hero {
  margin: 0 -24rpx 20rpx;
  padding: 48rpx 32rpx 36rpx;
  background: linear-gradient(145deg, #0F2456 0%, #1B4B8F 45%, #1677FF 100%);
  color: #fff;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: var(--shadow-lg);
}
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; }
.hero .n { font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero .s { font-size: 24rpx; opacity: .88; margin-top: 10rpx; line-height: 1.5; }
.hero-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,.18);
  font-size: 22rpx;
}
.bell-wrap {
  position: relative;
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.15);
  display: flex; align-items: center; justify-content: center;
}
.bell-ic { font-size: 36rpx; }
.bell-nb {
  position: absolute; top: 4rpx; right: 4rpx;
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx;
  border-radius: 16rpx; background: #FF4D4F; color: #fff;
  font-size: 20rpx; line-height: 32rpx; text-align: center; font-weight: 700;
  border: 2rpx solid #fff;
}

/* 快捷入口（习讯云式） */
.quick-row {
  display: flex;
  margin: -20rpx 0 20rpx;
  padding: 28rpx 12rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.quick-ic {
  width: 96rpx; height: 96rpx;
  border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.quick-tl { font-size: 24rpx; color: var(--t2); font-weight: 500; }
.qa-checkin { background: linear-gradient(135deg, #E6F4FF, #BAE0FF); }
.qa-log { background: linear-gradient(135deg, #FFF7E6, #FFE7BA); }
.qa-leave { background: linear-gradient(135deg, #F9F0FF, #EFDBFF); }
.qa-report { background: linear-gradient(135deg, #E6FFFB, #B5F5EC); }
.qa-review { background: linear-gradient(135deg, #FFF1F0, #FFCCC7); }
.qa-urge { background: linear-gradient(135deg, #FFFBE6, #FFF1B8); }
.qa-risk { background: linear-gradient(135deg, #FFF2E8, #FFD8BF); }
.qa-stu { background: linear-gradient(135deg, #E6F4FF, #BAE0FF); }

/* 待办条 */
.todo-list { margin-bottom: 20rpx; }
.todo-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  background: var(--card);
  border-radius: var(--radius-sm);
  margin-bottom: 12rpx;
  box-shadow: var(--shadow);
}
.todo-item.warn { background: #FFFBEB; border-left: 6rpx solid #F59E0B; }
.todo-item.err { background: #FEF2F2; border-left: 6rpx solid #EF4444; }
.todo-item.info { background: #EFF6FF; border-left: 6rpx solid #3B82F6; }
.todo-ic { font-size: 36rpx; flex-shrink: 0; }
.todo-body { flex: 1; min-width: 0; }
.todo-title { font-size: 28rpx; font-weight: 600; color: var(--t1); }
.todo-desc { font-size: 24rpx; color: var(--t2); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.todo-arrow { color: var(--t3); font-size: 32rpx; }

/* 进度 */
.prog-card { padding: 24rpx 28rpx; }
.prog-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.prog-row:first-child { margin-top: 0; }
.pl { font-size: 24rpx; color: var(--t2); width: 72rpx; font-weight: 500; }
.prog-bar { flex: 1; height: 12rpx; border-radius: 8rpx; background: #F3F4F6; overflow: hidden; }
.prog-fill { height: 100%; border-radius: 8rpx; background: linear-gradient(90deg, #1677FF, #13C2C2); transition: width .3s; }
.pv { font-size: 24rpx; color: var(--t3); width: 96rpx; text-align: right; font-variant-numeric: tabular-nums; }

/* 流程步骤条 */
.flow-scroll { width: 100%; white-space: nowrap; }
.flow-track {
  display: inline-flex;
  padding: 8rpx 0 16rpx;
}
.flow-node {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  position: relative;
}
.flow-node::after {
  content: '';
  position: absolute;
  top: 28rpx;
  left: 60rpx;
  width: 120rpx;
  height: 4rpx;
  background: #E5E7EB;
  z-index: 0;
}
.flow-node:last-child::after { display: none; }
.flow-node.done::after { background: #86EFAC; }
.flow-circle {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: #F3F4F6;
  color: var(--t3);
  font-size: 24rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 1;
  font-weight: 600;
}
.flow-node.active .flow-circle { background: #FEF3C7; color: #D97706; box-shadow: 0 0 0 4rpx #FDE68A; }
.flow-node.done .flow-circle { background: #DCFCE7; color: #16A34A; }
.flow-label { font-size: 20rpx; color: var(--t3); margin-top: 10rpx; text-align: center; line-height: 1.3; }
.flow-node.active .flow-label { color: #D97706; font-weight: 600; }
.flow-node.done .flow-label { color: #16A34A; }

.flow-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: linear-gradient(90deg, #EFF6FF, #ECFEFF);
  border-radius: var(--radius-sm);
  margin-bottom: 16rpx;
}
.flow-summary .pct { font-size: 36rpx; font-weight: 700; color: var(--blue); }
.flow-summary .txt { font-size: 24rpx; color: var(--t2); }

/* 功能宫格 */
.menu-group { margin-bottom: 8rpx; }
.menu-grid { display: flex; flex-wrap: wrap; }
.menu-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  position: relative;
  box-sizing: border-box;
}
.menu-ic {
  width: 88rpx; height: 88rpx;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  margin-bottom: 10rpx;
}
.menu-tl { font-size: 22rpx; color: var(--t2); text-align: center; line-height: 1.35; }
.menu-nb {
  position: absolute; top: 8rpx; right: 16rpx;
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx;
  border-radius: 16rpx; background: #FF4D4F; color: #fff;
  font-size: 20rpx; line-height: 32rpx; text-align: center; font-weight: 600;
}
.ic-b { background: #E6F4FF; }
.ic-g { background: #F6FFED; }
.ic-o { background: #FFF7E6; }
.ic-p { background: #F9F0FF; }
.ic-t { background: #E6FFFB; }
.ic-y { background: #FFFBE6; }
.ic-r { background: #FFF1F0; }
.ic-m { background: #F5F5F5; }

/* 教师指标 */
.metric-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.metric-cell {
  flex: 0 0 calc(33.333% - 12rpx);
  background: var(--card);
  border-radius: var(--radius-sm);
  padding: 20rpx 12rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow);
  box-sizing: border-box;
  position: relative;
  transition: transform .15s, box-shadow .15s;
}
.metric-cell.hot {
  background: linear-gradient(180deg, #FFF7E6 0%, #FFFFFF 100%);
  border: 2rpx solid #FFD591;
}
.metric-cell .ic { font-size: 32rpx; display: block; margin-bottom: 6rpx; }
.metric-cell .v { font-size: 44rpx; font-weight: 700; color: var(--brand); line-height: 1.2; }
.metric-cell.hot .v { color: #FA541C; }
.metric-cell .l { font-size: 22rpx; color: var(--t3); margin-top: 6rpx; }
.metric-cell .go { font-size: 20rpx; color: var(--blue); margin-top: 8rpx; opacity: .85; }
.metric-cell.zero { opacity: .72; }
.metric-cell.zero .go { color: var(--t3); }

.tap-active { opacity: .88; transform: scale(0.97); }

.prog-row-tap { padding: 8rpx 0; border-radius: 12rpx; }
.prog-row-tap:active { background: #F3F4F6; }
.row-tap { border-radius: 12rpx; margin: 0 -8rpx; padding-left: 8rpx; padding-right: 8rpx; }
.row-tap:active { background: #F3F4F6; }
.link-a { color: var(--blue); }
.ent-card-tap:active { opacity: .92; }

.review-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  padding: 8rpx 0 16rpx;
}
.review-tab {
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--t2);
  background: var(--card);
  border: 2rpx solid var(--border);
  box-shadow: var(--shadow);
}
.review-tab.on {
  background: var(--blue-light);
  color: var(--blue);
  border-color: #91CAFF;
  font-weight: 600;
}
.review-tab .nb {
  display: inline-block;
  min-width: 28rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  border-radius: 14rpx;
  background: #FF4D4F;
  color: #fff;
  font-size: 20rpx;
  line-height: 28rpx;
  vertical-align: middle;
}
.review-tab.on .nb { background: var(--blue); }

/* CTA 双按钮 */
.cta-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.cta-primary {
  flex: 1;
  padding: 28rpx 20rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #1677FF, #0958D9);
  color: #fff;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, .35);
}
.cta-primary .t { font-size: 30rpx; font-weight: 700; }
.cta-primary .d { font-size: 22rpx; opacity: .85; margin-top: 6rpx; }
.cta-secondary {
  flex: 1;
  padding: 28rpx 20rpx;
  border-radius: var(--radius);
  background: var(--card);
  color: var(--t1);
  text-align: center;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--border);
}
.cta-secondary .t { font-size: 30rpx; font-weight: 600; }
.cta-secondary .d { font-size: 22rpx; color: var(--t3); margin-top: 6rpx; }

.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--border);
}
.row:last-child { border-bottom: 0; }
.row .m { font-size: 28rpx; }
.row .d { font-size: 24rpx; color: var(--t3); margin-top: 4rpx; }
.row .right { text-align: right; display: flex; align-items: center; gap: 8rpx; }

.kv { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid var(--border); font-size: 28rpx; }
.kv:last-child { border-bottom: 0; }
.kv .k { color: var(--t3); }

.tag { display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 500; }
.tag-g { background: #F6FFED; color: #389E0D; }
.tag-y { background: #FFFBE6; color: #D48806; }
.tag-r { background: #FFF1F0; color: #CF1322; }
.tag-b { background: #E6F4FF; color: #0958D9; }
.tag-m { background: #F5F5F5; color: #8C8C8C; }
/* 商用岗位卡片：要求标签 + 福利 chips */
.ptags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.ptag { font-size: 22rpx; color: #5A6B7B; background: #F2F5F9; border-radius: 8rpx; padding: 4rpx 14rpx; }
.ptag-hot { background: #FFF1F0; color: #CF1322; }
.welfare { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.wchip { font-size: 22rpx; color: #0958D9; background: #E6F4FF; border-radius: 8rpx; padding: 4rpx 14rpx; }
/* 申请项 + 投递进度时间轴 */
.appitem { padding: 22rpx 0; border-bottom: 1rpx solid var(--border); }
.appitem:last-child { border-bottom: 0; }
.steps { display: flex; margin-top: 20rpx; }
.step { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; }
.step::before { content: ''; position: absolute; top: 13rpx; left: -50%; width: 100%; height: 3rpx; background: #E5E9F0; z-index: 0; }
.step:first-child::before { display: none; }
.step.s-done::before, .step.s-current::before { background: #1677FF; }
.step.s-reject::before { background: #CF1322; }
.step-dot { width: 28rpx; height: 28rpx; border-radius: 50%; background: #E5E9F0; z-index: 1; display: flex; align-items: center; justify-content: center; font-size: 18rpx; color: #fff; line-height: 1; }
.step.s-done .step-dot { background: #1677FF; }
.step.s-current .step-dot { background: #1677FF; box-shadow: 0 0 0 6rpx rgba(22,119,255,.15); }
.step.s-reject .step-dot { background: #CF1322; }
.step-label { font-size: 20rpx; color: #8C8C8C; margin-top: 8rpx; }
.step.s-done .step-label, .step.s-current .step-label { color: #1677FF; }
.step.s-reject .step-label { color: #CF1322; }

.btn {
  display: block; width: 100%; padding: 26rpx;
  border-radius: var(--radius-sm);
  background: var(--blue); color: #fff;
  font-size: 30rpx; font-weight: 600;
  margin-top: 16rpx; text-align: center; box-sizing: border-box; border: 0;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, .25);
}
.btn::after { border: 0; }
.btn-o { background: #fff; color: var(--blue); border: 2rpx solid var(--blue); box-shadow: none; }
.btn-r { background: #fff; color: var(--red); border: 2rpx solid #FFA39E; box-shadow: none; }
.btn-sm { display: inline-block; width: auto; padding: 12rpx 28rpx; font-size: 24rpx; margin: 0 0 0 12rpx; box-shadow: none; }
button[disabled] { opacity: .55; }

.field-label { display: block; font-size: 26rpx; color: var(--t2); margin: 20rpx 0 10rpx; font-weight: 500; }
.input, .textarea {
  width: 100%; padding: 22rpx 24rpx; border: 2rpx solid var(--border);
  border-radius: var(--radius-sm); font-size: 28rpx; background: #FAFBFC; box-sizing: border-box;
}
.textarea { min-height: 180rpx; }
.fld-err { color: var(--red); font-size: 22rpx; margin-top: 6rpx; min-height: 28rpx; }

.empty { text-align: center; color: var(--t3); padding: 80rpx 24rpx; font-size: 26rpx; }
.empty .ei { font-size: 80rpx; display: block; margin-bottom: 16rpx; opacity: .45; }

.retry { text-align: center; color: var(--t3); padding: 100rpx 24rpx; }
.retry .ei { font-size: 80rpx; display: block; margin-bottom: 16rpx; }

.detail-body {
  font-size: 28rpx; line-height: 1.75; white-space: pre-wrap;
  background: #FAFBFC; border-radius: var(--radius-sm); padding: 24rpx; margin-top: 12rpx;
}

.seg { display: flex; background: #F3F4F6; border-radius: var(--radius-sm); padding: 6rpx; margin-bottom: 20rpx; }
.seg .seg-i { flex: 1; text-align: center; padding: 16rpx; border-radius: 12rpx; font-size: 26rpx; color: var(--t2); }
.seg .seg-i.on { background: #fff; color: var(--t1); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }

.link-a { color: var(--blue); }

.sk { background: linear-gradient(90deg, #eef2f6 25%, #f8fafc 50%, #eef2f6 75%); background-size: 200% 100%; animation: shimmer 1.2s infinite; border-radius: 12rpx; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
.sk-card { background: var(--card); border-radius: var(--radius); padding: 28rpx; margin-bottom: 20rpx; }
.sk-line { height: 28rpx; margin: 16rpx 0; }

.loading { text-align: center; color: var(--t3); padding: 100rpx 0; font-size: 26rpx; }

.mask {
  position: fixed; inset: 0; background: rgba(15, 23, 42, .5);
  z-index: 200; display: flex; align-items: flex-end;
}
.sheet {
  background: #fff; width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(env(safe-area-inset-bottom) + 36rpx);
  max-height: 86vh; overflow-y: auto;
  box-sizing: border-box;
}
.sheet-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 28rpx; }

/* 列表单元格（我的页） */
.cell-group { margin-bottom: 20rpx; overflow: hidden; border-radius: var(--radius); box-shadow: var(--shadow); }
.cell-group-hd { padding: 20rpx 28rpx 8rpx; font-size: 24rpx; color: var(--t3); font-weight: 500; background: var(--card); }
.cell {
  display: flex; align-items: center;
  padding: 28rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--border);
}
.cell:last-child { border-bottom: 0; }
.cell-ic { width: 64rpx; height: 64rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-right: 20rpx; flex-shrink: 0; }
.cell-body { flex: 1; font-size: 28rpx; color: var(--t1); }
.cell-arrow { color: var(--t3); font-size: 28rpx; }

.ent-card {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FAFBFC, #F0F5FF);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--border);
}
.ent-ic { width: 80rpx; height: 80rpx; border-radius: 20rpx; background: #1677FF; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 700; }
.ent-info .name { font-size: 30rpx; font-weight: 600; }
.ent-info .meta { font-size: 24rpx; color: var(--t3); margin-top: 6rpx; }

/* ===== 商业化对标 v2 增量样式 ===== */

/* 数据统计条（工学云式） */
.stat-strip {
  display: flex;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 26rpx 0 22rpx;
  margin-bottom: 20rpx;
}
.stat-i { flex: 1; text-align: center; position: relative; }
.stat-i:not(:last-child)::after {
  content: '';
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  width: 1rpx; height: 48rpx; background: var(--border);
}
.stat-i .v { font-size: 40rpx; font-weight: 700; color: var(--t1); font-variant-numeric: tabular-nums; line-height: 1.2; }
.stat-i .l { font-size: 22rpx; color: var(--t3); margin-top: 6rpx; }
.stat-i .v.c-b { color: var(--blue); }
.stat-i .v.c-g { color: #389E0D; }
.stat-i .v.c-y { color: #D48806; }
.stat-i .v.c-r { color: var(--red); }

/* 筛选标签组 */
.chips { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 20rpx; }
.chip {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--t2);
  background: var(--card);
  border: 2rpx solid var(--border);
}
.chip.on { background: var(--blue); color: #fff; border-color: var(--blue); font-weight: 600; }
.chip .nb { margin-left: 4rpx; opacity: .8; font-size: 22rpx; }

/* 提醒横幅 */
.banner {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: 25rpx;
  margin-bottom: 20rpx;
  line-height: 1.45;
}
.banner .bi { font-size: 32rpx; flex-shrink: 0; }
.banner .bx { flex: 1; }
.banner .ba { font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.banner-warn { background: #FFFBEB; color: #B45309; border: 1rpx solid #FDE68A; }
.banner-warn .ba { color: #D97706; }
.banner-ok { background: #F0FDF4; color: #15803D; border: 1rpx solid #BBF7D0; }

/* 打卡日历 */
.cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.cal-head .cm { font-size: 30rpx; font-weight: 600; }
.cal-legend { display: flex; gap: 20rpx; font-size: 22rpx; color: var(--t3); }
.cal-legend .dot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 6rpx; vertical-align: middle; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.285%; text-align: center; padding: 8rpx 0; box-sizing: border-box; }
.cal-wk { font-size: 22rpx; color: var(--t3); padding: 8rpx 0; }
.cal-day {
  width: 64rpx; height: 64rpx; line-height: 64rpx;
  border-radius: 50%; margin: 0 auto;
  font-size: 26rpx; color: var(--t1);
  font-variant-numeric: tabular-nums;
}
.cal-day.dim { color: var(--t3); opacity: .35; }
.cal-day.hit { background: #DCFCE7; color: #16A34A; font-weight: 700; }
.cal-day.miss { background: #FEF2F2; color: #F87171; }
.cal-day.today { box-shadow: inset 0 0 0 3rpx var(--blue); font-weight: 700; }

/* 彩色首字头像 */
.avatar {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 600; flex-shrink: 0;
}
.av-0 { background: linear-gradient(135deg, #1677FF, #69B1FF); }
.av-1 { background: linear-gradient(135deg, #13C2C2, #5CDBD3); }
.av-2 { background: linear-gradient(135deg, #FA8C16, #FFC069); }
.av-3 { background: linear-gradient(135deg, #722ED1, #B37FEB); }
.av-4 { background: linear-gradient(135deg, #EB2F96, #FF85C0); }
.av-5 { background: linear-gradient(135deg, #52C41A, #95DE64); }

/* 快捷评语 / 快捷选项 */
.qc-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 10rpx 0 4rpx; }
.qc {
  padding: 10rpx 22rpx;
  background: #F3F4F6;
  border-radius: 24rpx;
  font-size: 23rpx;
  color: var(--t2);
  border: 1rpx solid var(--border);
}
.qc:active, .qc.on { background: var(--blue-light); color: var(--blue); border-color: #91CAFF; }

/* 字数统计 */
.char-count { display: block; text-align: right; font-size: 22rpx; color: var(--t3); margin-top: 8rpx; }
.char-count.warn { color: var(--orange); }

/* 表单分组标题 */
.form-sec { font-size: 26rpx; font-weight: 600; color: var(--t1); margin: 28rpx 0 4rpx; }

/* 列表行内评语 */
.row-cmt {
  font-size: 23rpx; color: var(--t2);
  background: #F8FAFC; border-radius: 10rpx;
  padding: 10rpx 16rpx; margin-top: 8rpx;
}
.row-cmt .who { color: var(--blue); }
