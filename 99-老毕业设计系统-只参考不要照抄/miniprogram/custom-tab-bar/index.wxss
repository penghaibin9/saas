.tabbar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid #EEF0F4;
  box-shadow: 0 -4rpx 24rpx rgba(15, 36, 86, 0.06);
  z-index: 100;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 20rpx;
  position: relative;
  padding-top: 8rpx;
}
.tab-item.on { color: #1677FF; font-weight: 600; }
.tab-item.on::before {
  content: '';
  position: absolute;
  top: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #1677FF;
}
.tab-item .ico { position: relative; font-size: 44rpx; line-height: 1; margin-bottom: 6rpx; }
.tab-item .txt { line-height: 1; letter-spacing: 1rpx; }
.tab-item .badge {
  position: absolute;
  top: -6rpx; right: -24rpx;
  min-width: 30rpx; height: 30rpx; line-height: 30rpx;
  padding: 0 8rpx;
  background: #FF4D4F; color: #fff;
  font-size: 18rpx; border-radius: 15rpx; text-align: center;
  font-weight: 600;
  border: 2rpx solid #fff;
}
