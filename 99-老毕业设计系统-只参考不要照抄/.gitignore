# 依赖
node_modules/

# 前端构建产物
dist/
.vite/

# 环境变量与密钥（绝不提交）
.env
.env.*
!.env.example

# 含数据库明文密码的配置，不入库
SQL/application.yml

# 上传文件
internship-backend/uploads/*
!internship-backend/uploads/.gitkeep
internship-backend/backups/

# HTTPS 私钥和证书（服务器上单独放置）
internship-backend/deploy/certs/*
!internship-backend/deploy/certs/.gitkeep
internship-backend/deploy/nginx.https.conf

# 编辑器 / 工具配置
.claude/
.vscode/
**/.claude/
**/.vscode/

# 日志与杂项
*.log
.DS_Store
Thumbs.db

# 工具快照产物 / Office 临时锁文件
.snapshots/
~$*
