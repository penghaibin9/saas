{
  "moduleKey": "internship-key",
  "moduleLabel": "岗位实习中心关键原型",
  "coverageType": "ten-key-workspaces-covering-twelve-production-modules",
  "sourceOfTruth": ["frontend/src/config/navPlan.js", "internship production routes, Vue pages, APIs and services"],
  "productionImplementationStatus": "ten high-frequency workbenches registered across twelve second-level modules; ninety-nine third-level entries remain tracked through coveredRoutes rather than duplicated as ninety-nine HTML pages",
  "sharedAssets": ["shared/v2-internship-key.js", "shared/v2-internship-key.css"],
  "principles": [
    "every operational record keeps batch context",
    "effective rule versions are immutable for active participants",
    "student identity comes from student master",
    "enterprise approval, job publication and specialty matching are separate decisions",
    "recommendation and bulk matching never skip conflict resolution or three-party agreement confirmation",
    "approved leave produces a LEAVE trace rather than a fake normal check-in",
    "report returns preserve versions and visit issues close through rectification and recheck",
    "risk facts, evidence, responsibility, deadlines and actions remain traceable",
    "score review, publication and recheck remain separate",
    "employment facts remain in the employment module and archived evidence is immutable"
  ],
  "routes": [
    {
      "route": "/admin/internship",
      "coveredRoutes": ["/admin/internship/batch-progress", "/admin/internship/todos", "/admin/internship/risks", "/admin/internship/stats?dimension=trend"],
      "html": "internship/dashboard.html",
      "title": "实习总览",
      "permissionCandidates": ["internship.dashboard.view", "internship.todo.view", "internship.risk.view", "internship.stats.view"]
    },
    {
      "route": "/admin/internship/batches",
